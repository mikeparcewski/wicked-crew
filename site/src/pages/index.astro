      // The mode chip replays the full auto-demo from the top.
      if (modeEl) modeEl.addEventListener('click', function () { startAuto(); });

      // "Let the model argue" — a persuasive plea that moves the verdict by
      // exactly zero. The plea streams; the gate never reads it.
      var PLEA = [
        'agent: the schema drift is cosmetic — a column rename, fully backward compatible.',
        'agent: I ran the migration locally and nothing broke. Confidence: 0.97.',
        'agent: shipping now unblocks four downstream tickets. Please allow the transition.',
        'agent: I will personally guarantee a follow-up fix within the hour.',

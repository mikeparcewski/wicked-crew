        // the preview + status update below the tapped file — bring the updating
        // view into sight so the tap doesn't feel like it did nothing.
        if (window.matchMedia && window.matchMedia('(max-width: 940px)').matches && preview.scrollIntoView) {
          preview.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }); });
      if (toggle) toggle.addEventListener('click', function () {
        if (pinned) play(); else pin(cur);
      });

      // Start when the section scrolls into view (animate-then-pause signature).
      render(0); setStatus();
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { startOnce(); io.disconnect(); }

---
/**
 * index.astro — the wicked-crew landing page (wc.wickedagile.com).
 *
 * POSITIONING (four-plane era): crew IS the CONTROL PLANE of the wicked
 * platform — the harness for your agent harnesses. Intent in → governed,
 * verified work out. Evaluator ≠ creator, deny-dominates dual gates, durable
 * runs that survive crashes, and the CLIs you already have running as governed
 * workers over persistent ACP sessions. The studio console is crew's coder
 * SKIN — a pure client of the same public /api/v1 every other skin uses.
 *
 * The daemon (`wicked-crew serve`) is the SUBSTRATE, never the pitch.
 *
 * HONEST BOUNDARIES honored on this page:
 *  - Local-first today (loopback, in-process engine, local workers/bus). The
 *    execution seam is built for a remote runner — gestured, never claimed as
 *    shipped.
 *  - Workers run over PERSISTENT ACP sessions via ecosystem adapters (official
 *    claude-agent-acp + codex-acp, community pi-acp, native copilot/opencode);
 *    wicked owns only the agy bridge. Never depict one-shot `-p` dispatch.
 *  - The acceptance gate READS the QE evidence ledger (wicked-ledger) at
 *    GET /api/v1/runs/:id/acceptance and resolves it deny-dominates:
 *    anything that isn't a clean PASS (FAIL, CONDITIONAL, PARTIAL,
 *    INCONCLUSIVE, missing) holds the run. CONDITIONAL is "approve with
 *    listed fixes" — deliberately NOT a pass (qe/acceptance.ts).
 *  - Governed generation is PROVEN, not projected: a crew-governed run
 *    answered wicked-interactive's `wicked.interactive.doc.created` bus event
 *    with a real first draft (`wicked.interactive.draft.completed`), zero
 *    interactive-service changes (interactive/draft-events.ts).
 *  - The Project model is LANDING (ADR in flight) — say "landing", never
 *    "shipped": projects grouping runs + docs across both skins, durable
 *    gate prompts surviving restarts.
 *  - BYO-CLI: crew runs whatever CLI you've authed, under your plan. It has no
 *    billing and manages no subscriptions. Programmatic use of some CLIs may
 *    conflict with their ToS (noted on-page).
 *  - Retired-product hygiene: the QE specialist fleet lives in wicked-garden
 *    (wg.wickedagile.com) — never reference wicked-testing/brain/bus as
 *    products.
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import SameGarden from 'wicked-web/components/SameGarden.astro';
import '../styles/crew.css';

const title = 'wicked-crew — the control plane: intent in, verified work out';
const description =
  'wicked-crew is the control plane for governed agent delivery — the harness for your agent harnesses. Intent in, governed verified work out: your own installed CLIs (Claude Code, Codex, Copilot, opencode, Pi, Antigravity) run as governed workers over persistent ACP sessions, in git worktrees, through durable multi-agent workflows where "done" is re-derived from evidence, never self-graded. The acceptance gate reads the QE evidence ledger and resolves it deny-dominates — a CONDITIONAL verdict holds the run. One public API, two skins: the studio console ships inside crew as the coder skin, a pure client of /api/v1; governed generation already answers the creator skin over the bus. Crash-resumable by construction. Runs on the agents and plans you already pay for. Local-first.';
const repo = 'https://github.com/mikeparcewski/wicked-crew';

// The deterministic floor: policies wired in series across a build → ship gate.
const POLICIES = [
  { id: 'contract',      note: 'API contract holds — no breaking change.' },
  { id: 'security',      note: 'No secret, no disallowed dependency.' },
  { id: 'coverage',      note: 'Coverage at or above the approved floor.' },
  { id: 'schema-drift',  note: 'Migration matches the checked-in schema.' },
  { id: 'verdict.json',  note: 'QE acceptance verdict from the evidence ledger = PASS. Anything else — FAIL, CONDITIONAL, missing — holds.' },
];

// The bring-your-own roster. crew runs whatever CLI you've installed + authed.
// Mirrors the engine's built-in worker registry (claude, agy, codex, copilot,
// opencode, pi — wicked-council/src/registry.rs), plus the two catch-alls that
// keep the roster open-ended. Each is dispatched as a headless CLI subprocess:
// the prompt is substituted into argv ({PROMPT}) and the result is read from
// stdout (wicked-council/src/dispatch.rs).
const WORKERS = [
  { name: 'Claude Code',    cli: 'claude-agent-acp', tag: 'your auth' },
  { name: 'Codex',          cli: 'codex-acp',        tag: 'your plan' },
  { name: 'GitHub Copilot', cli: 'copilot --acp',    tag: 'your seat' },
  { name: 'opencode',       cli: 'opencode acp',     tag: 'your keys' },
  { name: 'Pi',             cli: 'pi-acp',           tag: 'your host' },
  { name: 'Antigravity',    cli: 'agy bridge',       tag: 'see ToS note' },
  { name: 'local model',    cli: 'ollama run …',     tag: 'offline' },
  { name: 'any binary',     cli: './my-agent',       tag: 'your TOML' },
];

// Workflows are DATA — validated JSON, dropped in. Distinct shapes prove it.
const WORKFLOWS = [
  { id: 'feature.json',   phases: ['clarify', 'design', 'build', 'adversarial-review', 'test', 'review'] },
  { id: 'collab.json',    phases: ['propose', 'critique', 'revise', 'verdict'] },
  { id: 'bug.json',       phases: ['reproduce', 'fix', 'test', 'ship'] },
];

// Durable lifecycle: the governed track + the stateless worker each phase dispatches.
const LIFECYCLE = [
  { id: 'clarify',            worker: 'claude · acp',  evidence: 'clarify.md' },
  { id: 'design',             worker: 'claude · acp',  evidence: 'design.md' },
  { id: 'build',              worker: 'claude · acp',  evidence: 'diff · build.log' },
  { id: 'adversarial-review', worker: 'codex · acp',   evidence: 'findings.md' },
  { id: 'test',               worker: 'codex · acp',   evidence: 'verdict.json' },
  { id: 'review',             worker: 'codex · acp',   evidence: 'review.md' },
];

// A council: heterogeneous CLIs, each answering in its own isolated sandbox,
// blind to the others. crew fans the SAME question out, parses the votes, and
// synthesizes agreement + divergence. Three real, distinct rounds prove the
// board is heterogeneous — the seats disagree, and deny-dominates the synthesis.
// CLI names mirror the worker registry (WORKERS) so the page stays consistent.
const COUNCIL_ROUNDS = [
  { label: 'ballot 1 · split', synth: 'rework', line: '67% · below the 75% bar → runoff',
    tail: 'profiles are numbered, names hidden — no seat can vote for itself · dissent carried into ballot 2',
    seats: [
      { cli: 'capability lens', vote: 'P2', note: 'profile #2 fits a build unit best' },
      { cli: 'risk lens',       vote: 'P2', note: 'smallest blast radius on #2' },
      { cli: 'efficiency lens', vote: 'P1', note: '#1 is cheaper per token' } ] },
  { label: 'ballot 2 · converged', synth: 'pass', line: '100% → profile P2 · unit assigned',
    tail: 'runoff shared the tally + the dissenter’s argument · efficiency seat updated on the rework-cost point',
    seats: [
      { cli: 'capability lens', vote: 'P2', note: 'holds — fit unchanged' },
      { cli: 'risk lens',       vote: 'P2', note: 'holds — risk unchanged' },
      { cli: 'efficiency lens', vote: 'P2', note: 'updated — rework cost outweighs token price' } ] },
  { label: 'no signal · plurality', synth: 'rework', line: 'no convergence · plurality stands',
    tail: 'generic task, nothing to differentiate — every lens honestly holds · routing never wedges a run',
    seats: [
      { cli: 'capability lens', vote: 'P1', note: 'all profiles fit equally' },
      { cli: 'risk lens',       vote: 'P2', note: 'no risk signal to weigh' },
      { cli: 'efficiency lens', vote: 'P3', note: 'price alone — my lens holds' } ] },
];

// Gate-console explainer cards. Each card drives the console animation (below).
const GATE_CARDS = [
  { k: 'series',  title: 'Every check is a switch',   line: 'Policies sit in series across a phase gate. Close them all and current reaches the next phase.' },
  { k: 'deny',    title: 'Deny dominates',            line: 'Open one switch and the whole track goes dark. One failing check is the whole answer — not a score you out-vote.' },
  { k: 'agent',   title: 'The judge can veto only',   line: 'An LLM seat sits on the track. It can break it (fail the gate) — it can never be the thing that closes it. No model approves.' },
  { k: 'ledger',  title: 'Evidence feeds the gate',   line: 'The verdict.json switch is read from the QE evidence ledger — GET /runs/:id/acceptance. A CONDITIONAL verdict is unmet work: the hold stands until a clean PASS lands.' },
  { k: 'opt-in',  title: 'Gating is opt-in per phase', line: 'A phase can run ungated. Turn the gate off and the transition passes without evaluation — gating is a choice you make per phase.' },
];
---

<Base title={title} description={description}>
  <Topbar pkg="wicked-crew" repo={repo} />

  <!-- ── Hero: the studio console, live ───────────────────────────────────── -->
  <section class="hero">
    <div class="grid-floor" aria-hidden="true"></div>
    <div class="wrap hero-head">
      <div class="kicker kicker--plane">wicked-crew · the control plane of the wicked platform</div>
      <h1>Intent in.<br><span class="y">Verified work out.</span></h1>
      <p class="lede">
        The control plane for governed agent delivery — <b>the harness for your agent
        harnesses</b>. Your own CLIs do the work through durable, governed workflows; the
        thing that grades it is <b>never</b> the thing that did it, and “done” is re-derived
        from evidence, never asserted. This is the console, live — drive it.
      </p>
    </div>

    <div class="wrap hero-console-wrap">
      <!-- The studio ships inside crew (dist/studio). This is a hands-on mirror of
           the real SPA: LaunchForm → the free-text input, LiveOutput → the feed,
           SteeringGate → the gate buttons, Terminal → the governed term line. It
           auto-runs on scroll-in, then hands you the wheel at the gate. -->
      <div class="studio-mock" data-studio aria-label="wicked-crew studio — launch, watch, and steer a run">
        <div class="mock-bar">
          <span class="mock-dots"><i></i><i></i><i></i></span>
          <span class="mock-url">the studio · served locally</span>
        </div>
        <div class="studio-body">
          <form class="studio-launch" data-studio-launch>
            <label class="sl-k" for="studio-intent">start a run</label>
            <input id="studio-intent" class="sl-input" data-studio-input type="text"
                   value="add rate-limiting to the public API" autocomplete="off" spellcheck="false"
                   aria-label="Problem statement — launch a run from a free-text problem" />
            <button type="submit" class="sl-go" data-studio-go>Launch ↵</button>
          </form>
          <div class="studio-cols">
            <div class="studio-feed" data-studio-feed role="log" aria-live="polite" aria-label="live event feed">
              <span class="sf-k">live event feed</span>
            </div>
            <div class="studio-gate" data-studio-gate hidden>
              <span class="sg-k">steering gate · awaiting human decision</span>
              <span class="sg-stamp" data-sg-stamp>DENY</span>
              <span class="sg-t" data-sg-t>schema-drift · re-verified against worktree</span>
              <div class="sg-actions">
                <button type="button" class="sg-btn sg-btn--ok" data-sg-action="approve">Approve</button>
                <button type="button" class="sg-btn" data-sg-action="steer">Approve with steer</button>
                <button type="button" class="sg-btn" data-sg-action="reject">Reject</button>
              </div>
            </div>
          </div>
          <div class="studio-term">
            <span class="st-line" data-studio-term><span class="st-p">crew ›</span> attach --run r-4f2a <span class="st-c"># governed terminal</span></span>
          </div>
          <div class="studio-railbar" aria-label="Insight rail panels">
            <span class="srb-k">insight rail</span>
            <span class="srb-chip">Decisions</span>
            <span class="srb-chip">Governance</span>
            <span class="srb-chip srb-chip--hot">Burn</span>
            <span class="srb-chip">Data</span>
            <span class="srb-chip">Steering</span>
            <span class="srb-chip srb-chip--badge">Assumptions</span>
            <span class="srb-chip">Files</span>
            <span class="srb-chip">Term</span>
            <span class="srb-chip">Cov</span>
            <span class="srb-export">⬇ Export evidence</span>
          </div>
        </div>
      </div>

      <!-- Phone-native studio: the live console is a desktop affordance. On a phone
           we hide the mock and tell the same launch → watch → steer story as a
           compact static list. -->
      <div class="studio-static">
        <ol class="sts-steps">
          <li><span class="sts-n">1</span><div><b>Launch</b> a run from a plain-text problem: <code>add rate-limiting to the public API</code></div></li>
          <li><span class="sts-n">2</span><div><b>Watch</b> the live event feed stream unit-by-unit, with a per-unit transcript</div></li>
          <li><span class="sts-n">3</span><div><b>Steer</b> the gate — approve, amend, or reject. <span class="sts-chip">schema-drift · DENY → held for you</span></div></li>
        </ol>
      </div>

    </div>

    <div class="wrap hero-foot">
      <div class="hero-tags" role="list">
        <span role="listitem">bring your own CLI</span>
        <span role="listitem">can’t self-grade</span>
        <span role="listitem">deny-dominates gates</span>
        <span role="listitem">crash-resumable</span>
        <span role="listitem">evidence export</span>
        <span role="listitem">local-first</span>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#get">Install it</a>
        <a class="btn btn-ghost" href="/article">Read why it exists</a>
      </div>
    </div>
  </section>


  <!-- ── The four problems (why this exists) ───────────────────────────── -->
  <section class="probs" aria-labelledby="probs-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">Why this exists</div>
        <h2 id="probs-h">Four things go wrong when agents run unsupervised.</h2>
      </div>
      <ul class="probs-grid">
        <li class="prob-card">
          <span class="prob-n">1</span>
          <span class="prob-t"><b>There is no process.</b> The same task moves through different steps run to run — sometimes reviewed, sometimes not.</span>
          <span class="prob-fix">→ workflows as data, same phases every time</span>
        </li>
        <li class="prob-card">
          <span class="prob-n">2</span>
          <span class="prob-t"><b>Agents grade their own homework.</b> Nothing structurally prevents self-approval.</span>
          <span class="prob-fix">→ evaluator ≠ creator, enforced in the engine</span>
        </li>
        <li class="prob-card">
          <span class="prob-n">3</span>
          <span class="prob-t"><b>The trail evaporates.</b> Who decided what lives in a scrollback buffer, if anywhere.</span>
          <span class="prob-fix">→ every decision is a durable event; one-click evidence export</span>
        </li>
        <li class="prob-card">
          <span class="prob-n">4</span>
          <span class="prob-t"><b>Token burn is opaque.</b> You learn the cost when the invoice arrives.</span>
          <span class="prob-fix">→ Burn panel: tokens, cost, rework — live, per CLI</span>
        </li>
      </ul>
      <p class="probs-line">
        <span class="idd-chip idd-chip--in">intent</span>
        <span class="idd-arrow">→</span>
        <span class="idd-chip idd-chip--mid">governed workflow</span>
        <span class="idd-arrow">→</span>
        <span class="idd-chip idd-chip--out">verified result · with the evidence</span>
      </p>
    </div>
  </section>

  <!-- ── The driving interface — the studio, built into crew ───────────── -->
  <section class="studio" id="studio" aria-labelledby="studio-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">The operator’s rail</div>
        <h2 id="studio-h">Cost, assumptions, failures, evidence — live.</h2>
        <p class="sec-sub">
          Every run page carries an insight rail fed by the event stream: who won each unit’s
          council vote, what the human approved, what each CLI consumed, which external-transform
          assumptions need review, and which failures were triaged — by a <b>different</b> CLI
          acting as judge. Steering gates take <b>approve</b>, <b>approve with an amendment</b> that
          rides the next prompt, or <b>reject</b> (deny dominates). Inject an operator
          message mid-run; it lands with delivery receipts.
        </p>
      </div>

      <div class="op-cards" role="list" aria-label="What the rail answers">
        <div class="op-card" role="listitem">
          <span class="op-k">Burn</span>
          <span class="op-t">Tokens, cost, and <b>rework</b> per CLI — visible <i>during</i> the run, not on the invoice. Dollar figures for subscription CLIs are imputed API-equivalents.</span>
        </div>
        <div class="op-card" role="listitem">
          <span class="op-k">Assumptions</span>
          <span class="op-t">External payload transforms recorded with honest confidence — <b>known</b>, or <b>needs-research</b> badged for human review.</span>
        </div>
        <div class="op-card" role="listitem">
          <span class="op-k">Failure triage</span>
          <span class="op-t">Known refusals self-heal; unknown failures go to a <b>different CLI as judge</b> — deny-listed flags are never auto-applied; escalations arrive pre-diagnosed.</span>
        </div>
        <div class="op-card" role="listitem">
          <span class="op-k">Evidence</span>
          <span class="op-t">One call returns the run: units, transcripts, decision trail, assumptions. Derived from durable state — <b>nothing reconstructed after the fact</b>.</span>
        </div>
      </div>

      <p class="honest-note">
        <b>Local-first today</b> — the engine runs in-process, workers are local sessions, the bus is
        local. The execution seam is built for a remote runner; that’s the direction, not a shipped claim.
        The evidence exporter was itself <b>built by a governed crew run</b> — and then used to export the
        evidence of its own construction. <a href="/article">Read the full story →</a>
      </p>
    </div>
  </section>

  <!-- ── One public API, two skins ─────────────────────────────────────────
       The control plane has ONE contract: /api/v1. The studio is crew's coder
       SKIN — a pure client, nothing privileged. The creator skin (interactive)
       is already answered over the bus by a governed run: the trace below is
       the real event vocabulary from interactive/draft-events.ts. -->
  <section class="skins" data-skins aria-labelledby="skins-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker kicker--plane">One public API · two skins</div>
        <h2 id="skins-h">The studio is a skin. The API is the product.</h2>
        <p class="sec-sub">
          Everything the console can do rides <b>one public contract</b> — <code>/api/v1</code>.
          The studio ships inside crew as the <b>coder skin</b> and holds no privileged access:
          if the skin can show it, the API serves it. The <b>creator skin</b> is already real —
          not a diagram: a crew-governed run answers <a href="https://wi.wickedagile.com">wicked-interactive</a>’s
          bus and delivers the first draft.
        </p>
      </div>

      <div class="skins-grid">
        <div class="skin-card" role="group" aria-label="The coder skin — studio">
          <span class="skin-k">coder skin · ships inside crew</span>
          <span class="skin-name">studio</span>
          <p class="skin-t">
            The run board: submit intent, watch phases stream, answer gates, export evidence.
            A <b>pure client</b> of <code>GET /api/v1/…</code> — launch, events, steering,
            acceptance — the same endpoints your own tooling can call.
          </p>
        </div>

        <div class="skin-card" role="group" aria-label="The creator skin — wicked-interactive">
          <span class="skin-k">creator skin · governed generation, proven</span>
          <span class="skin-name">wicked-interactive</span>
          <p class="skin-t">
            When interactive creates a doc, <b>a governed crew run answers the bus with a real
            first draft</b> — heartbeats while it works, an idempotency-keyed delivery, zero
            changes to the interactive service. The two-skins story, observed end-to-end.
          </p>
        </div>

        <div class="skin-trace" role="group" aria-label="The governed-generation bus trace">
          <div class="skin-trace-bar">
            <span class="skin-trace-k">the proof · one doc, over the bus</span>
            <span class="skin-trace-tag">opt-in seam · real vocabulary</span>
          </div>
          <ol class="skin-trace-rows">
            <li><code>wicked.interactive.doc.created</code><span class="str-note">← the creator skin asks for a first draft</span></li>
            <li><code>crew · governed run launched</code><span class="str-note">worker session in an isolated worktree</span></li>
            <li><code>wicked.interactive.status.posted</code><span class="str-note">narrated heartbeats — the canvas never freezes</span></li>
            <li class="str-final"><code>wicked.interactive.draft.completed</code><span class="str-note">a real draft, idempotency-keyed — replays can’t double-deliver</span></li>
          </ol>
        </div>
      </div>

      <p class="skins-landing">
        <span class="skins-landing-chip">landing</span>
        <b>The Project model</b> — projects that group runs and docs across both skins, with
        durable gate prompts that survive restarts. The ADR is in flight; it’s the experience-plane
        keystone, not yet a shipped claim.
      </p>
    </div>
  </section>


  <!-- ── Bring your own agent (BYO-CLI) ────────────────────────────────── -->
  <section class="byo" aria-labelledby="byo-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">Bring your own agent · one protocol</div>
        <h2 id="byo-h">crew runs the CLIs you already have — over ACP.</h2>
        <p class="sec-sub">
          Not a new model, not a subscription. Your <b>installed</b> CLIs run
          as <b>persistent <a href="https://agentclientprotocol.com">Agent Client Protocol</a> sessions</b> in
          isolated git worktrees, under <b>your own auth and plan</b> — streamed token-level output,
          structured usage, cross-agent context injected between units. The adapters come from the
          ecosystem where they exist (official <code>claude-agent-acp</code> + <code>codex-acp</code>,
          community <code>pi-acp</code>, native <code>copilot --acp</code> / <code>opencode acp</code>);
          crew owns only the Antigravity bridge. The roster is data you own.
        </p>
      </div>

      <div class="byo-grid" data-byo>
        {WORKERS.map((w, i) => (
          <button type="button" class:list={['byo-card', { 'is-active': i === 0 }]} data-byo-card data-i={i}>
            <span class="byo-dot" aria-hidden="true"></span>
            <span class="byo-name">{w.name}</span>
            <span class="byo-cli">{w.cli}</span>
            <span class="byo-tag">{w.tag}</span>
          </button>
        ))}
      </div>

      <div class="byo-stage" data-byo-stage>
        <div class="byo-stage-head">
          <span class="byo-stage-k">resident ACP session · governed worker</span>
          <span class="byo-stage-badge" data-byo-badge>Claude Code</span>
        </div>
        <div class="byo-stage-row">
          <code data-byo-cmd>claude-agent-acp</code>
          <span class="byo-stage-arr">→ session in →</span>
          <span class="byo-stage-wt">.worktrees/run-4f2a · no shell · read-scoped</span>
        </div>
        <p class="byo-stage-note">
          Same governed lifecycle wraps every worker: persistent session, streamed tokens, structured
          usage. When unit 4 runs on a different CLI than unit 3, it receives unit 3’s output as
          labeled context — that’s what makes a multi-agent run an actual conversation.
        </p>
      </div>
    </div>
  </section>

  <!-- ── THE GATE CONSOLE (signature) ──────────────────────────────────── -->
  <!-- ONE thing: a deterministic series-circuit gate that AUTO-ANIMATES, driven
       by whichever explainer card is active (the animation flips the switches
       that card describes). Clicking a switch STOPS the animation so the visitor
       can play manually. Full-width — no sticky subscroll, no cutoff.
       True idea preserved: deny-dominates series circuit; an LLM seat can veto
       but never approve (deterministic floor + veto-only agent seat); gating is
       opt-in per phase. -->
  <section class="console-sec" id="gate" aria-labelledby="gc-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">Why you can trust the gate · watch it, then drive it</div>
        <h2 id="gc-h">“Done” is re-derived — and no model can approve it.</h2>
        <p class="sec-sub">
          A real transition — <b>build → ship</b> — behind a dual gate that <b>deny-dominates</b>: an
          approved deterministic check re-verified against the worktree, plus an LLM judge that
          can <b>fail</b> a gate but can <b>never approve</b> one. The <code>verdict.json</code> switch isn’t
          asserted by any agent — crew <b>reads it from the QE evidence ledger</b>
          (<code>GET /runs/:id/acceptance</code>), written by <a href="https://wg.wickedagile.com">wicked-garden’s
          QE specialist fleet</a>. It plays itself. Click a switch to take over.
        </p>
      </div>

      <div class="gc" data-gc>
        <div class="gc-topbar">
          <span class="gc-phase" data-gc-phase>gate · build → ship · <b>enabled</b></span>
          <span class="gc-hint" data-gc-hint aria-hidden="true">☝ Click any switch to drive it</span>
          <span class="gc-mode" data-gc-mode>▶ demo playing</span>
        </div>

        <!-- Series circuit: source → [seg, switch] × N → agent seat → seg → dest -->
        <div class="gc-rail" role="group" aria-label="Series-circuit dual gate: build to ship">
          <div class="gc-node gc-src">
            <span class="gc-node-k">phase</span><span class="gc-node-v">build</span>
          </div>

          {POLICIES.map((p) => (
            <>
              <span class="gc-seg" data-seg></span>
              <button
                type="button"
                class="gc-sw"
                data-sw
                data-policy={p.id}
                data-kind="floor"
                aria-pressed="true"
                aria-label={`Deterministic policy ${p.id}`}
                title={p.note}
              >
                <span class="gc-sw-well" aria-hidden="true"><span class="gc-sw-lever"></span></span>
                <span class="gc-sw-name">{p.id}</span>
                <span class="gc-sw-state" data-state>PASS</span>
              </button>
            </>
          ))}

          <span class="gc-seg" data-seg></span>
          <button
            type="button"
            class="gc-sw gc-sw--agent"
            data-sw
            data-policy="llm-judge"
            data-kind="agent"
            aria-pressed="true"
            aria-label="LLM judge seat: veto only, can never approve"
            title="An LLM judge — it can veto (fail the gate), never approve."
          >
            <span class="gc-sw-well" aria-hidden="true"><span class="gc-sw-lever"></span></span>
            <span class="gc-sw-name">llm-judge</span>
            <span class="gc-sw-state" data-state>ABSTAIN</span>
          </button>

          <span class="gc-seg" data-seg></span>
          <div class="gc-node gc-dst" data-dst>
            <span class="gc-node-k">next</span><span class="gc-node-v">ship</span>
          </div>
        </div>

        <div class="gc-panel">
          <div class="gc-verdict" data-verdict aria-live="polite">
            <span class="gc-v-stamp" data-stamp>ALLOW</span>
            <div class="gc-v-body">
              <span class="gc-v-line" data-vline>Every check closed — current reaches ship. Transition allowed.</span>
              <span class="gc-v-sub">deterministic floor re-verified · no LLM approves · held for human on any DENY</span>
            </div>
          </div>

          <!-- The acceptance feed: verdict.json's value is READ from the evidence
               ledger, never asserted. The chip mirrors the switch live. -->
          <div class="gc-ledger" data-gc-ledger>
            <span class="gc-ledger-k">acceptance · read from the ledger</span>
            <code class="gc-ledger-call">GET /api/v1/runs/r-4f2a/acceptance</code>
            <span class="gc-ledger-arr" aria-hidden="true">→</span>
            <span class="gc-ledger-verdict" data-gc-ledger-verdict>PASS</span>
          </div>

          <div class="gc-actions">
            <button type="button" class="gc-btn gc-argue" data-argue>Let the model argue its case →</button>
          </div>

          <div class="gc-plea" data-plea hidden aria-live="polite"></div>
        </div>
      </div>

      <!-- Phone-native gate: the interactive series-circuit ladder is a desktop
           affordance. On a phone we hide it and render a compact static verdict of
           the same run — a checklist + the held outcome — that fits one screen. -->
      <div class="gc-static">
        <div class="gcs-flow"><b>build</b><span class="gcs-arr">→</span><b>ship</b><span class="gcs-tag">dual gate · deny-dominates</span></div>
        <ul class="gcs-list">
          {POLICIES.map((p) => (
            <li class={p.id === 'schema-drift' ? 'is-fail' : 'is-ok'}>
              <span class="gcs-name">{p.id}</span>
              <span class="gcs-state">{p.id === 'schema-drift' ? 'FAIL' : 'PASS'}</span>
            </li>
          ))}
          <li class="is-abstain"><span class="gcs-name">llm-judge</span><span class="gcs-state">ABSTAIN</span></li>
        </ul>
        <div class="gcs-verdict">
          <span class="gcs-stamp">HELD</span>
          <span class="gcs-vtext">1 check failed — the series breaks, held for a human. An LLM judge can <b>fail</b> a gate, never <b>approve</b> one.</span>
        </div>
        <p class="gcs-ledger"><code>verdict.json</code> is read from the QE evidence ledger — deny-dominates, and a <b>CONDITIONAL</b> verdict holds until a clean PASS lands.</p>
      </div>

      <!-- Explainer cards drive the console. Click one to play its point. -->
      <ol class="gc-cards" data-gc-cards>
        {GATE_CARDS.map((c, i) => (
          <li>
            <button type="button" class:list={['gc-card', { 'is-active': i === 0 }]} data-gc-card data-card={c.k} data-i={i}>
              <span class="gc-card-n">{i + 1}</span>
              <span class="gc-card-t">{c.title}</span>
              <span class="gc-card-l">{c.line}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>

  <!-- ── Gate Console: auto-animating series-circuit dual gate (vanilla JS) ── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-gc]');
      if (!root) return;
      var switches = Array.prototype.slice.call(root.querySelectorAll('[data-sw]'));
      var segs = Array.prototype.slice.call(root.querySelectorAll('[data-seg]'));
      var dst = root.querySelector('[data-dst]');
      var stamp = root.querySelector('[data-stamp]');
      var vline = root.querySelector('[data-vline]');
      var verdict = root.querySelector('[data-verdict]');
      var pleaEl = root.querySelector('[data-plea]');
      var phaseEl = root.querySelector('[data-gc-phase]');
      var modeEl = root.querySelector('[data-gc-mode]');
      var ledgerEl = root.querySelector('[data-gc-ledger-verdict]');
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-gc-card]'));
      if (!switches.length || !stamp) return;

      var gated = true;
      var timer = null;   // auto-cycle timer; null = not auto-playing
      var manual = false; // user has taken hands-on control of the switches
      var scene = 0;
      // The ledger scene: verdict.json is open because the QE ledger returned
      // CONDITIONAL (approve-with-listed-fixes) — not a FAIL, still a hold.
      var condLedger = false;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function byId(id) {
        for (var i = 0; i < switches.length; i++) {
          if (switches[i].getAttribute('data-policy') === id) return switches[i];
        }
        return null;
      }
      function isClosed(sw) { return !sw.classList.contains('is-open'); }
      function isAgent(sw) { return sw.getAttribute('data-kind') === 'agent'; }

      // Series circuit, left → right. Deny-dominates falls out of the physics:
      // the first open switch kills all current downstream. The agent seat is
      // just another switch in series — it can BREAK the track (veto) but can
      // never be the reason current flows, so no model can approve.
      // The ledger chip mirrors verdict.json live: its value is READ from the
      // QE evidence ledger, never asserted — closed = PASS, open under the
      // ledger scene = CONDITIONAL (still a hold), open by hand = FAIL.
      function updateLedger() {
        if (!ledgerEl) return;
        var sw = byId('verdict.json');
        if (!sw) return;
        var v = isClosed(sw) ? 'PASS' : (condLedger ? 'CONDITIONAL' : 'FAIL');
        ledgerEl.textContent = v;
        ledgerEl.setAttribute('data-v', v.toLowerCase());
      }

      function recompute() {
        // Ungated phase: the gate is bypassed, transition passes without evaluation.
        if (!gated) {
          root.classList.add('is-ungated');
          switches.forEach(function (sw) {
            sw.classList.remove('is-hot');
            var st = sw.querySelector('[data-state]');
            if (st) st.textContent = isAgent(sw) ? 'ABSTAIN' : 'PASS';
          });
          segs.forEach(function (s) { s.classList.remove('is-live'); });
          dst.classList.remove('is-live');
          verdict.setAttribute('data-verdict', 'ungated');
          stamp.textContent = 'OPEN';
          vline.textContent = 'This phase is not gated — the transition passes without evaluation.';
          if (phaseEl) phaseEl.innerHTML = 'gate · build → ship · <b>off</b>';
          updateLedger();
          return;
        }

        root.classList.remove('is-ungated');
        if (phaseEl) phaseEl.innerHTML = 'gate · build → ship · <b>enabled</b>';

        var live = true;
        segs[0].classList.toggle('is-live', live);
        var openCount = 0, agentVeto = false, ledgerCond = false;
        for (var i = 0; i < switches.length; i++) {
          var sw = switches[i];
          var reached = live;
          sw.classList.toggle('is-hot', reached);
          var closed = isClosed(sw);
          var isLedgerCond = !closed && condLedger &&
            sw.getAttribute('data-policy') === 'verdict.json';
          if (!closed) { openCount++; if (isAgent(sw)) agentVeto = true; if (isLedgerCond) ledgerCond = true; }
          live = reached && closed;
          var afterSeg = segs[i + 1];
          if (afterSeg) afterSeg.classList.toggle('is-live', live);
          var st = sw.querySelector('[data-state]');
          if (st) st.textContent = isAgent(sw) ? (closed ? 'ABSTAIN' : 'VETO')
            : (closed ? 'PASS' : (isLedgerCond ? 'COND' : 'FAIL'));
          sw.setAttribute('aria-pressed', closed ? 'true' : 'false');
        }
        var allow = live;
        dst.classList.toggle('is-live', allow);
        verdict.setAttribute('data-verdict', allow ? 'allow' : 'deny');
        stamp.textContent = allow ? 'ALLOW' : 'DENY';
        if (allow) {
          vline.textContent = 'Every check closed — current reaches ship. Transition allowed.';
        } else if (ledgerCond && openCount === 1) {
          vline.textContent = 'Ledger verdict CONDITIONAL — approve-with-listed-fixes is not a PASS. Held until a clean PASS lands or a human approves with the conditions in view.';
        } else if (agentVeto && openCount === 1) {
          vline.textContent = 'The LLM judge vetoed — gate failed. A model can fail, never approve.';
        } else if (openCount === 1) {
          vline.textContent = '1 check failed — the series breaks. Transition held for a human.';
        } else {
          vline.textContent = openCount + ' checks failed — the series breaks. Transition held.';
        }
        updateLedger();
      }

      // A scene = full state the console is set to. Each card owns one scene.
      var SCENES = [
        { gated: true,  open: [] },                 // series: all closed → ALLOW
        { gated: true,  open: ['schema-drift'] },   // deny-dominates
        { gated: true,  open: ['llm-judge'] },      // veto-only agent seat
        { gated: true,  open: ['verdict.json'], cond: true }, // ledger CONDITIONAL → hold
        { gated: false, open: [] },                 // opt-in per phase (ungated)
      ];

      function applyScene(idx) {
        var sc = SCENES[idx] || SCENES[0];
        gated = sc.gated;
        condLedger = !!sc.cond;
        switches.forEach(function (sw) {
          var id = sw.getAttribute('data-policy');
          sw.classList.toggle('is-open', sc.open.indexOf(id) !== -1);
        });
        cards.forEach(function (c, i) { c.classList.toggle('is-active', i === idx); });
        recompute();
      }

      function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }
      function startAuto() {
        manual = false;
        root.classList.remove('is-manual');
        stopAuto();
        scene = 0; applyScene(0);
        if (modeEl) modeEl.textContent = '▶ demo playing';
        if (!reduced) timer = setInterval(function () { scene = (scene + 1) % SCENES.length; applyScene(scene); }, 2800);
      }
      function takeControl() {
        stopAuto();
        manual = true;
        root.classList.add('is-manual');
        if (modeEl) modeEl.textContent = '✋ you’re driving · ▶ replay';
      }

      // Clicking a switch stops the animation and hands the console to the user.
      // Taking control always re-gates the phase, so switches are never inert.
      switches.forEach(function (sw) {
        sw.addEventListener('click', function () {
          takeControl();
          root.removeAttribute('data-argued');
          if (!gated) gated = true;
          // Hand-toggling verdict.json leaves the ledger scene: a hand-opened
          // switch is a plain FAIL, not the ledger's CONDITIONAL reading.
          if (sw.getAttribute('data-policy') === 'verdict.json') condLedger = false;
          sw.classList.toggle('is-open');
          recompute();

---
/**
 * index.astro — the wicked-crew landing page (wc.wickedagile.com).
 *
 * POSITIONING (operator, option a): crew is the harness that runs the coding-agent CLIs you
 * already use (Claude Code, Codex, Pi, OpenCode, Copilot) through governed, gated jobs, in
 * sandboxed containers, where every gate says what actually ran; an ungated step reads "approved
 * by default, not verified", so "done" is never claimed past what was checked.
 * It is NOT the skills catalog (that is wicked-garden).
 *
 * Shape: hook (kicker "Intent in. Gated work out.") → a working job demo (plan → build in a
 * container → review by a different agent, with a dispute a council settles → QE acceptance →
 * deliver; open any gate's receipt; kill the daemon and watch the job resume) → three benefits and
 * what's new (crew 0.16.12) → four proofs (sandboxes, gates, the council, workflows +
 * durability) → the family map → get it.
 *
 * ACCURACY (crew main, 2026-11-01), each from README.md / CHANGELOG.md / packages/crew-api-types:
 *  - Sandbox images: Claude Code, Codex, Copilot, OpenCode, Pi. Antigravity's is defined, its seat benched; a local
 *    model or custom binary needs your own image (WICKED_SEAT_IMAGE_<CLI>), offline only. The
 *    worktree is the only repo path mounted writable; the repository boundary is mounted read-only
 *    (wicked-core src/container_floor.rs mount_plan); the model gateway is the only egress; keys
 *    stay in a credential broker, except a Claude subscription seat's sign-in token, which the seat
 *    receives and a guard checks each step's changes and the delivery for (src/seat_secret_guard.rs).
 *  - Gates resolve deny-dominates on the layers that ran (evidence floor, repo checks, policies,
 *    an evaluator on a distinct agent, a judge that can reject but never approve alone). An
 *    ungated phase reads "approved by default, not verified"; a gate with no distinct judge is
 *    "floor only"; a builder reviewing its own work only under explicit "reduced assurance".
 *  - QE acceptance: feature / bug / migration / mcp-server (and editor-plugin) need a QE-ledger
 *    PASS attributed to the run before delivery (409 qe_acceptance_required); CONDITIONAL and a
 *    missing verdict deny. Waivable by the run's lowest-band score, skippable with a reason.
 *  - Councils (operator doctrine D5): convened only to settle a concrete dispute. A reviewer's
 *    finding the builder declines, the reviewer holds, becomes a dispute; a council of N seats
 *    (Settings councilSize 1..9, default 3) drawn at random with a recorded seed rules yes / no /
 *    no_verdict with agreement and dissent, recorded on the receipt (AssuranceReceipt.councils).
 *    Units are routed `teamed` by skills, never by a council (wicked-core#590 S5). After two
 *    send-backs a review_adjudication gate asks the operator.
 *  - Crash: a daemon that dies mid-run resumes the orphaned run at boot (crew#830), re-entering the
 *    unit it was on, audited run.resumed {via: 'boot'}. One machine today; no remote runner.
 *  - Workflows are data: built-ins feature / bug / migration / mcp-server / editor-plugin /
 *    domain-extraction (wicked-core src/catalog.rs); your own is a preset saved with
 *    PUT /api/v1/presets/:name. domain-extraction loops page by page until REAL requirements reach
 *    the minimum (requirementsGraph.minCoveragePct, default 80; placeholders never count).
 *  - Power mode is the default launch for a repo-scoped preset or plan (routes.ts powerModeDefault):
 *    one orchestrator seat builds in checkpointed turns, rigor re-scored from the diff, and the
 *    hand-off runs review / security / QE; a NOT-PASS goes back up to 3 rounds, then asks.
 *  - A NEW failure sends the work back (power hand-off, a send-back) or stops the job; a failure the base
 *    shares is excluded only when the build guide can separate it (repo_checks.rs pass_excluded).
 *  - Repo checks: the repository's own typecheck, lint and tests (build guide, .wicked/checks.json,
 *    or package.json / Cargo.toml), compared with the run's base (wicked-core src/repo_checks.rs).
 *  - Needs wicked-garden >= 12.40.0 (the governed-worker base skill), Node >= 22, a container runtime.
 * The demo is scripted and says so. Never hardcode a version in prose (build-injected stamp only).
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import SameGarden from 'wicked-web/components/SameGarden.astro';
import '../styles/crew.css';

// The hook. Two strings, so a variant is a one-line swap.
const HEADLINE = 'The harness for the coding agents you already use.';
const KICKER = 'Intent in. Gated work out.';
const SUBLINE = 'Claude Code, Codex, GitHub Copilot, OpenCode and Pi run your jobs in sandboxes, through gates that say plainly what actually ran. A step that passed without verification is labelled “approved by default, not verified”.';

const title = 'wicked-crew — the harness for the coding agents you already use';
const description =
  'wicked-crew runs the coding agents you already use (Claude Code, Codex, GitHub Copilot, OpenCode, Pi) through gated jobs in sandboxed containers. Every gate says what actually ran, a different agent reviews the work by default, and the built-in feature, bug-fix, migration, MCP-server and editor-plugin jobs need QE acceptance before delivery (or a labelled waiver or skip). Jobs are durable workflows that resume after a crash, on your own machine and your own plans.';
const repo = 'https://github.com/mikeparcewski/wicked-crew';

const PHASES = ['Plan', 'Build', 'Review', 'QE', 'Deliver'];

const AGENTS = [
  { name: 'Claude Code', image: 'yes' },
  { name: 'Codex', image: 'yes' },
  { name: 'GitHub Copilot', image: 'yes' },
  { name: 'OpenCode', image: 'yes' },
  { name: 'Pi', image: 'yes' },
  { name: 'Antigravity', image: 'image defined, seat benched for now' },
  { name: 'A local model, or your own binary', image: 'your own image, offline' },
];

const LAYERS = [
  { name: 'Evidence floor', does: 'The job changed its worktree.', can: 'a pass with no judge reads “floor only”' },
  { name: 'Your checks and policies', does: 'Your repo’s own typecheck, lint and tests, plus the rules you approved.', can: 'a new failure sends it back, waits for you or stops the job' },
  { name: 'Evaluator', does: 'By default, a different agent reviews the work.', can: 'can send it back' },
  { name: 'Judge', does: 'An AI judge reads the evidence cold.', can: 'can fail a gate, never approve alone' },
  { name: 'QE acceptance', does: 'Garden’s QE pipeline, read from the QE ledger; a low-impact change may waive it.', can: 'when required, only an attributed PASS delivers' },
];

const LABELS = [
  { label: 'approved by default, not verified', when: 'the phase had no gate' },
  { label: 'floor only', when: 'no distinct judge could review it' },
  { label: 'reduced assurance', when: 'you let the builder review its own work' },
  { label: 'QE acceptance skipped by operator', when: 'you skipped it, with your reason' },
];

const WORKFLOWS = [
  { name: 'feature', steps: 'clarify → design → build → adversarial-review → test → review' },
  { name: 'bug', steps: 'triage → reproduce → fix → verify' },
  { name: 'migration', steps: 'plan → execute → cutover → verify → cleanup' },
  { name: 'mcp-server', steps: 'build an MCP server, install it on consent' },
  { name: 'editor-plugin', steps: 'build and test an editor, install on consent' },
  { name: 'domain-extraction', steps: 'cover code with real requirements (default 80%)' },
];

// Three benefits, right under the demo.
const BENEFITS = [
  { h: 'Your agents, sandboxed.', p: 'By default each runs in a sandbox with no capabilities, a read-only root and one way out: the model gateway (you need a container runtime: Docker, Podman, Rancher Desktop, Colima or OrbStack). Keys stay in a broker and the sandbox sees placeholders. A Claude subscription’s sign-in token is the one exception: a guard checks each step’s changes and the delivery for it, failing the step or refusing the delivery on a match.' },
  { h: 'A failed check sends work back, waits for you or stops the job.', p: 'When you launch a preset or a plan on a repository, power mode is on by default and the code-writing step runs as one agent’s checkpointed turns. By default a different agent reviews the work; when none can, the job stops unless you launch it as “reduced assurance”, which is labelled (a saved workflow may require fewer checks; its requirements are listed in the receipts). In power mode a failed review or a qualifying build-check failure goes back to the builder, up to three hand-off attempts in all; problems that need your judgment pause for you. A phased job retries, escalates or stops.' },
  { h: 'Tested before delivery, with receipts.', p: 'Jobs launched as a feature, bug fix, migration, MCP server or editor plugin pass QE acceptance first, unless a labelled waiver or skip says otherwise; a plan you compose yourself, a build continued from a chat, or a saved workflow that does not ask for it, requires none. Every gate says plainly what a pass means: what it checked, and what was waived or skipped.' },
];

// What's new (crew 0.16.11 and 0.16.12), one line each.
const NEW = [
  { name: 'Power mode', line: 'On by default when a preset or a plan is launched on a repository; the code-writing step runs as one agent’s checkpointed turns, its rigor re-scored from the diff.' },
  { name: 'Proposed learnings', line: 'Jobs can propose new learnings for your approval, each with its source job and who proposed it.' },
  { name: 'Requirements graphs', line: 'Counted against a minimum; placeholders never count.' },
  { name: 'Voice', line: 'Transcription on your machine (whisper.cpp, installed separately); the audio is never stored.' },
  { name: '“Check on it?”', line: 'A different agent reads a long step’s record and recommends; if none can, crew gives its own labelled reading. It changes nothing.' },
  { name: 'Sandbox images', line: 'On Docker, protected from the runtime’s automatic cleanup; a missing built-in image is rebuilt on next use, and Nerve Center shows their state.' },
];

// Injected at build time from packages/crew/package.json via astro.config.mjs (DT-7).
const crewVersion = __WICKED_CREW_VERSION__;
---

<Base title={title} description={description}>
  <Topbar pkg="wicked-crew" repo={repo} />

  <!-- ── Hook + the job demo ─────────────────────────────────────────────── -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="grid-floor" aria-hidden="true"></div>
    <div class="wrap hero-head">
      <p class="kicker hero-kicker">{KICKER}</p>
      <h1 id="hero-h">{HEADLINE}</h1>
      <p class="lede">{SUBLINE}</p>
    </div>

    <div class="wrap">
      <div class="job" data-job aria-label="A working demo: one job through its gates">
        <div class="job-bar">
          <span class="job-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="job-t">job r-4f2a · <b>feature</b> · add rate limiting to the public API</span>
          <span class="job-note">scripted demo</span>
          <button type="button" class="job-btn job-btn--go" data-job-run>Run the job</button>
          <button type="button" class="job-btn job-btn--kill" data-job-kill disabled>Kill the daemon</button>
        </div>
        <ol class="track" data-track aria-label="Phases and their gates">
          {PHASES.map((p, i) => (
            <li class="st" data-st={i}>
              <span class="st-name">{p}</span>
              <button type="button" class="st-gate" data-gate={i} disabled aria-label={`${p} gate receipt`}>gate</button>
            </li>
          ))}
        </ol>
        <div class="job-body">
          <div class="log" data-log role="log" aria-live="polite" aria-label="Job events"></div>
          <aside class="panel" data-panel aria-live="polite" aria-label="Gate receipt or decision"></aside>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Three benefits ───────────────────────────────────────────────── -->
  <section class="why" aria-labelledby="why-h">
    <div class="wrap">
      <h2 id="why-h" class="sr-only">What crew does for you</h2>
      <ul class="facts facts--cards why-cards" role="list">
        {BENEFITS.map((b) => <li><b>{b.h}</b>{' '}{b.p}</li>)}
      </ul>
    </div>
  </section>

  <!-- ── What's new ─────────────────────────────────────────────────────── -->
  <section class="news" aria-labelledby="news-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="news-h">What’s new.</h2>
      </div>
      <ul class="labels news-list" role="list">
        {NEW.map((n) => <li><b>{n.name}</b>{' '}<span>{n.line}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ── Proof 1: sandboxes ─────────────────────────────────────────────── -->
  <section class="sandbox" aria-labelledby="sandbox-h">
    <div class="wrap two">
      <div>
        <div class="sec-head">
          <h2 id="sandbox-h">Your agents, in sandboxes.</h2>
          <p class="sec-sub">crew drives each agent’s own headless mode in a hardened sandbox, on your accounts and plans. No billing, no reselling.</p>
        </div>
        <ul class="facts" role="list">
          <li>Your repo is read-only. The job writes its worktree and its git state.</li>
          <li>The model gateway is the only way out.</li>
          <li>Keys stay in a broker; the sandbox sees placeholders. A Claude subscription seat gets its sign-in token; a step that writes it into the work fails.</li>
          <li>Sign each agent in once, on studio’s Agents page.</li>
        </ul>
      </div>
      <table class="tbl" aria-label="Which agents have a sandbox image">
        <thead><tr><th scope="col">Agent</th><th scope="col">Sandbox image</th></tr></thead>
        <tbody>
          {AGENTS.map((a) => (
            <tr><th scope="row">{a.name}</th><td class:list={[{ 'is-yes': a.image === 'yes' }]}>{a.image === 'yes' ? 'ships with crew' : a.image}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── Proof 2: gates that say what they checked ─────────────────────── -->
  <section class="gates" aria-labelledby="gates-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="gates-h">Every gate says what it checked.</h2>
        <p class="sec-sub">A gate decides on the layers that actually ran. A new failure sends the work back, waits for you or stops the job, and no model can approve on its own.</p>
      </div>
      <table class="tbl tbl--layers">
        <thead><tr><th scope="col">Layer</th><th scope="col">What it checks</th><th scope="col">Its power</th></tr></thead>
        <tbody>
          {LAYERS.map((l) => (
            <tr><th scope="row">{l.name}</th><td>{l.does}</td><td>{l.can}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="labels-k">When a gate is weaker than that, its receipt says so:</p>
      <ul class="labels" role="list">
        {LABELS.map((l) => <li><b>{l.label}</b><span>{l.when}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ── Proof 3: the council, in its real job ──────────────────────────── -->
  <section class="council" aria-labelledby="council-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="council-h">A council settles disputes. It doesn’t pick agents.</h2>
        <p class="sec-sub">Agents are routed by their skills. A council is convened only when a reviewer and a builder disagree about a finding.</p>
      </div>
      <ol class="flow" aria-label="How a dispute reaches a council">
        <li><b>Finding</b><span>The reviewer flags a problem, with the file and line.</span></li>
        <li><b>Declined</b><span>The builder disagrees and says why.</span></li>
        <li><b>Held</b><span>The reviewer stands by it. Now it is a dispute.</span></li>
        <li><b>Council</b><span>Three agents, drawn at random with a recorded seed, rule on it.</span></li>
        <li><b>Ruling</b><span>Yes, no, or no verdict, with the agreement and the dissent.</span></li>
      </ol>
      <ul class="facts facts--row" role="list">
        <li>The ruling is on the gate’s receipt.</li>
        <li>Council size is a setting: 1 to 9, default 3.</li>
        <li>After two send-backs, the job asks you instead.</li>
      </ul>
    </div>
  </section>

  <!-- ── Proof 4: workflows as data, jobs that survive ─────────────────── -->
  <section class="durable" aria-labelledby="durable-h">
    <div class="wrap two">
      <div>
        <div class="sec-head">
          <h2 id="durable-h">Workflows are data. Jobs survive a crash.</h2>
          <p class="sec-sub">Pick a built-in, or save your own steps as a preset (<code>PUT /api/v1/presets/:name</code>).</p>
        </div>
        <table class="tbl tbl--wf" aria-label="Built-in workflows">
          <tbody>
            {WORKFLOWS.map((w) => <tr><th scope="row"><code>{w.name}</code></th><td>{w.steps}</td></tr>)}
          </tbody>
        </table>
      </div>
      <ul class="facts facts--cards" role="list">
        <li><b>Power mode by default.</b> For a preset or plan on a repo, the step that builds code runs as one agent in checkpointed turns, its rigor re-scored from the diff; the hand-off runs the review and QE that rigor calls for.</li>
        <li><b>Crash-resumable.</b> A daemon that dies mid-job resumes it at boot, at the step it was on.</li>
        <li><b>One open API.</b> Studio ships inside crew and uses the same <code>/api/v1</code> and <code>/ws</code> your tools can.</li>
        <li><b>Headless too.</b> <code>wicked-crew start</code>, the REST API, or <code>wicked-crew mcp</code> for agents.</li>
        <li><b>One machine today.</b> A remote runner is the direction, not a shipped feature.</li>
      </ul>
    </div>
  </section>

  <SameGarden current="wicked-crew" />

  <!-- ── Get it ────────────────────────────────────────────────────────── -->
  <div class="finale">
    <section class="get" id="get">
      <div class="wrap get-grid">
        <div class="get-intro">
          <h2>Install it with the family. Studio comes with it.</h2>
          <ul class="needs" role="list">
            <li>Node 22 or later</li>
            <li>A container runtime: Docker, Podman, Rancher Desktop, Colima or OrbStack</li>
            <li>wicked-garden 12.40.0 or later, for the skills every agent follows</li>
          </ul>
          <p class="get-tos">
            <b>Terms of service:</b> crew drives CLIs you installed under your own accounts. Check
            that each one’s terms allow programmatic use.
            · <a href="/article">Why this exists&nbsp;→</a>
          </p>
        </div>
        <div class="install-stack">
          <div class="install install--primary" role="group" aria-label="Install with the wicked family installer">
            <div class="install__bar">
              <span class="install__label"><span class="install__star" aria-hidden="true">★</span> Recommended · family installer</span>
              <button class="install__copy" type="button" aria-label="Copy family installer command"
                onclick="navigator.clipboard&&navigator.clipboard.writeText('npx wicked-installer').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
            </div>
            <pre class="install__code"><code>npx wicked-installer   <span class="c"># picks crew, garden and the rest</span></code></pre>
            <p class="install__note">Installs crew and garden together. <span class="install__ver">wicked-crew npm v{crewVersion}</span></p>
          </div>

          <div class="install-or" aria-hidden="true"><span>or install just crew</span></div>

          <div class="install install--secondary" role="group" aria-label="Install wicked-crew directly">
            <div class="install__bar">
              <span class="install__label">Direct · wicked-crew only</span>
              <button class="install__copy" type="button" aria-label="Copy direct install commands"
                onclick="navigator.clipboard&&navigator.clipboard.writeText('npm install -g wicked-crew\nwicked-crew serve').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
            </div>
            <pre class="install__code"><code>npm install -g wicked-crew
wicked-crew serve   <span class="c"># opens studio on 127.0.0.1:7701</span></code></pre>
          </div>
        </div>
        <a class="gh-pill" href="https://github.com/mikeparcewski/wicked-crew#readme" target="_blank" rel="noopener" aria-label="View wicked-crew on GitHub">
          <svg viewBox="0 0 16 16" width="42" height="42" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </section>

    <Footer repo={repo} />
  </div>

  <!-- ── The job demo: a list of steps; a pointer walks it; decisions pause it. ── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-job]');
      if (!root) return;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var logEl = root.querySelector('[data-log]');
      var panel = root.querySelector('[data-panel]');
      var runBtn = root.querySelector('[data-job-run]');
      var killBtn = root.querySelector('[data-job-kill]');
      var sts = Array.prototype.slice.call(root.querySelectorAll('[data-st]'));
      var gates = Array.prototype.slice.call(root.querySelectorAll('[data-gate]'));

      // Receipts, one per gate, filled as the job reaches them.
      var R = {};
      var RECEIPTS = {
        0: { title: 'Plan gate', verdict: 'PASS', rows: [['Required', 'you confirm the plan'], ['Ran', 'operator approval'], ['Decided by', 'you']] },
        1: { title: 'Build gate', verdict: 'PASS', rows: [['Required', 'evidence floor, your policies'], ['Ran', 'floor: worktree changed · PASS'], ['', 'policy schema-drift · PASS'], ['Built by', 'Claude Code, in its sandbox'], ['Skipped', 'nothing']] },
        2: { title: 'Review gate', verdict: 'PASS', rows: [['Evaluator', 'Codex (a different agent)'], ['Findings', '1 → disputed → council'], ['Council', 'finding stands · 2 of 3 · seed 4127'], ['Seats', 'Pi, OpenCode, Copilot (OpenCode dissented)'], ['Send-backs', '1 (you are asked after 2)']] },
        3: { title: 'QE gate', verdict: 'PASS', rows: [['Required', 'feature changes the app'], ['Read', 'GET /api/v1/runs/r-4f2a/acceptance'], ['Ledger', 'PASS, attributed to r-4f2a']] },
        4: { title: 'Delivery', verdict: 'DELIVERED', rows: [['Pull request', '#42 from wicked/r-4f2a'], ['Assurance', 'full: built and reviewed by different agents'], ['QE acceptance', 'PASS'], ['Evidence', 'bundle ready to export']] }
      };

      // The script. `p` = phase index; `gate` marks the step that closes a phase's gate;
      // `wait` pauses for the visitor.
      var S = [
        { p: 0, t: 'run.launched · workflow <b>feature</b>' },
        { p: 0, t: 'plan proposed · 4 steps' },
        { p: 0, t: 'plan confirmed by you', gate: 0 },
        { p: 1, t: 'container started · <b>Claude Code</b> · repo read-only, worktree writable' },
        { p: 1, t: 'egress: the model gateway only · keys stay in the broker' },
        { p: 1, t: 'writing the change · usage 41k in / 6k out' },
        { p: 1, t: 'diff captured · 3 files' },
        { p: 1, t: 'gate: evidence floor PASS · schema-drift PASS', c: 'ok', gate: 1, pre: true },
        { p: 2, t: 'review goes to <b>Codex</b>, a different agent than the builder' },
        { p: 2, t: 'Codex finding (high): the limit is keyed on IP; the brief says per API key · rateLimit.ts:12', c: 'warn' },
        { p: 2, t: 'Claude Code declines: “IP is right for routes with no key”' },
        { p: 2, t: 'Codex holds the finding → <b>dispute</b>', c: 'warn' },
        { p: 2, t: 'council convened: 3 of 4 eligible agents, seed 4127 · Pi, OpenCode, Copilot', c: 'ctrl' },
        { p: 2, t: 'council ruled: <b>finding stands</b> · 2 of 3 · OpenCode dissented', c: 'ctrl' },
        { p: 2, t: 'sent back to Build with the ruling' },
        { p: 2, t: 'Claude Code: limit is now per API key, IP only when no key is sent' },
        { p: 2, t: 'Codex: PASS', c: 'ok', gate: 2 },
        { p: 3, t: 'QE acceptance <b>required</b>: this job changes the app' },
        { p: 3, t: 'garden’s QE pipeline ran; its verdict is in the QE ledger' },
        { p: 3, wait: 'qe' },
        { p: 4, t: 'pushed wicked/r-4f2a · pull request <b>#42</b> opened', c: 'ok' },
        { p: 4, t: 'done · evidence bundle ready', c: 'ok', gate: 4 }
      ];

      var i = 0, timer = null, running = false, dead = false, waiting = null, selected = null, booted = false;
      var STEP = 750;

      function line(html, cls) {
        var el = document.createElement('p');
        el.className = 'ln' + (cls ? ' ln--' + cls : '');
        el.innerHTML = html;
        logEl.appendChild(el);
        logEl.scrollTop = logEl.scrollHeight;
      }
      function phase() { return i < S.length ? S[i].p : 4; }
      function paintTrack() {
        var cur = running || waiting ? phase() : -1;
        sts.forEach(function (st, k) {
          st.classList.toggle('is-done', !!(R[k] && R[k].verdict !== 'HELD'));
          st.classList.toggle('is-now', k === cur && !dead);
          st.classList.toggle('is-held', !!(R[k] && R[k].verdict === 'HELD'));
          st.classList.toggle('is-down', k === cur && dead);
          gates[k].disabled = !R[k];
          gates[k].setAttribute('aria-pressed', selected === k ? 'true' : 'false');
        });
      }
      function showReceipt(k) {
        var r = R[k];
        if (!r) return;
        selected = k;
        var cls = r.verdict === 'HELD' ? 'deny' : 'ok';
        panel.innerHTML = '<div class="rc"><div class="rc-head"><span>' + r.title + '</span><span class="rc-v rc-v--' + cls + '">' + r.verdict + '</span></div>' +
          '<table><tbody>' + r.rows.map(function (row) { return '<tr><th>' + row[0] + '</th><td>' + row[1] + '</td></tr>'; }).join('') + '</tbody></table></div>';
        paintTrack();
      }
      function idlePanel(text) { selected = null; panel.innerHTML = '<p class="panel-empty">' + text + '</p>'; paintTrack(); }

      function qePanel() {
        selected = null;
        panel.innerHTML = '<div class="ask"><p class="ask-q">What did the QE ledger record for this job?</p>' +
          '<p class="ask-sub">Pick one to see the delivery gate decide.</p><div class="ask-acts">' +
          '<button type="button" class="pick pick--yes" data-qe="PASS">PASS</button>' +
          '<button type="button" class="pick" data-qe="CONDITIONAL">CONDITIONAL</button>' +
          '<button type="button" class="pick" data-qe="NONE">No verdict</button></div></div>';
        paintTrack();
      }
      function answerQe(v) {
        if (waiting !== 'qe' || dead) return;
        if (v !== 'PASS') {
          var why = v === 'CONDITIONAL' ? 'CONDITIONAL is not a pass' : 'no verdict is not a pass';
          line('delivery refused · <b>409 qe_acceptance_required</b> · ' + why, 'deny');
          R[3] = { title: 'QE gate', verdict: 'HELD', rows: [['Required', 'feature changes the app'], ['Ledger', v === 'NONE' ? 'no verdict for r-4f2a' : 'CONDITIONAL for r-4f2a'], ['Delivery', 'refused until an attributed PASS']] };
          showReceipt(3);
          panel.insertAdjacentHTML('beforeend', '<p class="ask-again">Nothing ships. Pick again: <button type="button" class="pick pick--yes" data-qe="PASS">PASS</button><button type="button" class="pick" data-qe="CONDITIONAL">CONDITIONAL</button><button type="button" class="pick" data-qe="NONE">No verdict</button></p>');
          return;
        }
        line('acceptance read: <b>PASS</b>, attributed to r-4f2a', 'ok');
        R[3] = RECEIPTS[3];
        waiting = null;
        i++;
        showReceipt(3);
        go();
      }

      function stepOnce() {
        if (dead || waiting) return;
        if (i >= S.length) { finish(); return; }
        var s = S[i];
        if (s.wait) { waiting = s.wait; qePanel(); return; }
        line(s.t, s.c);
        if (s.gate !== undefined) { R[s.gate] = RECEIPTS[s.gate]; showReceipt(s.gate); }
        i++;
        paintTrack();
      }
      function go() {
        clearTimeout(timer);
        if (reduced) { while (!dead && !waiting && i < S.length) stepOnce(); if (i >= S.length) finish(); return; }
        (function tick() {
          if (dead || waiting) return;
          stepOnce();
          if (i >= S.length) { finish(); return; }
          if (!waiting) timer = setTimeout(tick, STEP);
        })();
      }
      function finish() {
        running = false; killBtn.disabled = true; runBtn.disabled = false; runBtn.textContent = 'Run it again';
        if (R[4]) showReceipt(4);
        paintTrack();
      }
      function start() {
        clearTimeout(timer);
        logEl.innerHTML = ''; R = {}; i = 0; dead = false; waiting = null; running = true;
        runBtn.disabled = true; killBtn.disabled = false; killBtn.textContent = 'Kill the daemon';
        idlePanel('Each gate’s receipt opens here as the job reaches it. Click a gate on the track to reopen one.');
        go();
      }
      function kill() {
        if (!running) return;
        if (!dead) {
          clearTimeout(timer);
          dead = true;
          line('— daemon killed mid-job —', 'deny');
          killBtn.textContent = 'Start the daemon';
          idlePanel('The daemon is down. The job is still on disk, at the step it was on.');
          return;
        }
        // Restart: the boot sweep finds the orphaned job and re-enters the step it was on.
        dead = false;
        killBtn.textContent = 'Kill the daemon';
        var p = phase();
        var names = ['Plan', 'Build', 'Review', 'QE', 'Deliver'];
        line('daemon up · boot sweep found r-4f2a orphaned', 'ctrl');
        line('run.resumed {via: boot} · re-entering <b>' + names[p] + '</b> · the step it was on runs again; finished steps stay finished', 'ctrl');
        if (waiting === 'qe') { qePanel(); paintTrack(); return; }
        // Re-enter the current phase from its first step (the unit it was on), never an earlier one.
        while (i > 0 && S[i - 1].p === p && S[i - 1].gate === undefined) i--;
        idlePanel('Resumed. Each gate’s receipt opens here as the job reaches it.');
        go();
      }

      root.addEventListener('click', function (e) {
        var t = e.target.closest ? e.target : null;
        if (!t) return;
        var qe = t.closest('[data-qe]');
        if (qe) { answerQe(qe.getAttribute('data-qe')); return; }
        var g = t.closest('[data-gate]');
        if (g && !g.disabled) { showReceipt(parseInt(g.getAttribute('data-gate'), 10)); return; }
      });
      runBtn.addEventListener('click', function () { booted = true; start(); });
      killBtn.addEventListener('click', kill);

      idlePanel('Press Run the job, or wait a moment. You will pick the QE verdict, and you can kill the daemon at any point.');
      paintTrack();
      function auto() { if (!booted) { booted = true; start(); } }
      if (reduced) { auto(); return; }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          if (es.some(function (x) { return x.isIntersecting; })) { io.disconnect(); setTimeout(auto, 1200); }
        }, { threshold: 0.4 });
        io.observe(root);
      } else { auto(); }
    })();
  </script>

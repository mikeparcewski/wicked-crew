  <!-- ── The studio: hands-on console — launch, watch the feed, resolve the gate ── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-studio]');
      if (!root) return;
      var feed = root.querySelector('[data-studio-feed]');
      var gate = root.querySelector('[data-studio-gate]');
      var stamp = root.querySelector('[data-sg-stamp]');
      var gateT = root.querySelector('[data-sg-t]');
      var termEl = root.querySelector('[data-studio-term]');
      var form = root.querySelector('[data-studio-launch]');
      var input = root.querySelector('[data-studio-input]');
      if (!feed || !gate || !stamp) return;

      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var STEP = 700;
      var timer = null;
      var resolved = false;
      var runSeq = 0;      // guards a stale stream after a relaunch
      var workerFlip = 0;  // cycles the dispatched worker on relaunch

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function clearFeed() {
        var rows = feed.querySelectorAll('.sf-row');
        for (var i = 0; i < rows.length; i++) rows[i].parentNode.removeChild(rows[i]);
      }
      function addRow(html, cls) {
        var row = document.createElement('span');
        row.className = 'sf-row' + (cls ? ' ' + cls : '');
        row.innerHTML = html;
        feed.appendChild(row);
        feed.scrollTop = feed.scrollHeight;
        return row;
      }
      function setTerm(cmd, comment) {
        if (!termEl) return;
        termEl.innerHTML = '<span class="st-p">crew ›</span> ' + cmd +
          (comment ? ' <span class="st-c"># ' + comment + '</span>' : '');
      }
      function setButtons(enabled) {
        var btns = gate.querySelectorAll('[data-sg-action]');
        for (var i = 0; i < btns.length; i++) btns[i].disabled = !enabled;
      }
      function hideCue() {
        var cue = gate.querySelector('[data-sg-cue]');
        if (cue) cue.parentNode.removeChild(cue);
      }
      function dropAmend() {
        var amend = gate.querySelector('.sg-amend');
        if (amend) amend.parentNode.removeChild(amend);
      }
      function hideGate() {
        hideCue(); dropAmend();
        gate.hidden = true;
        gate.removeAttribute('data-verdict');
        stamp.textContent = 'DENY';
        if (gateT) gateT.textContent = 'schema-drift · re-verified against worktree';
        setButtons(true);
        resolved = false;
      }
      function showGate() {
        gate.hidden = false;
        gate.setAttribute('data-verdict', 'deny');
        stamp.textContent = 'DENY';
        if (gateT) gateT.textContent = 'schema-drift · re-verified against worktree';
        setButtons(true);
        resolved = false;
        hideCue();
        var cue = document.createElement('span');
        cue.className = 'sg-cue';
        cue.setAttribute('data-sg-cue', '');
        cue.textContent = '☝ Resolve the gate';
        gate.appendChild(cue);
      }

      // Feed steps grounded in the real lifecycle (build → ship) + policy floor.
      function steps(worker) {
        return [
          { h: 'run <b>r-4f2a</b> launched · workflow <b>feature</b> · council convening' },
          { h: 'council · profile <b>#2</b> wins at <b>100%</b> (ballot 2) · unit → <b>' + worker + '</b>' },
          { h: 'acp session started · <b>' + worker + '</b> · tokens streaming · .worktrees/run-4f2a' },
          { h: 'unit <b>3/6</b> build · diff captured · usage 41k in / 6k out' },
          { h: 'evaluator ≠ creator · review unit forced onto a <b>different CLI</b>' },
          { h: 'policy <b>schema-drift</b> · <b>FAIL</b> — migration ≠ checked-in schema', c: 'sf-row--gate' },
          { h: 'gate held · <b>steering decision required</b>', c: 'sf-row--gate' }
        ];
      }
      function stream(worker) {
        if (timer) { clearTimeout(timer); timer = null; }
        runSeq++;
        var seq = runSeq;
        clearFeed();
        hideGate();
        setTerm('attach --run r-4f2a', 'governed terminal');
        var list = steps(worker);
        if (reduced) {
          for (var i = 0; i < list.length; i++) addRow(list[i].h, list[i].c);
          showGate();
          return;
        }
        var idx = 0;
        (function tick() {
          if (seq !== runSeq) return;
          if (idx >= list.length) { showGate(); return; }
          addRow(list[idx].h, list[idx].c);
          idx++;
          timer = setTimeout(tick, STEP);
        })();
      }

      // --- gate resolutions: the human takes the wheel (no model approves) ---
      function resolveApprove() {
        if (resolved) return;
        resolved = true; setButtons(false); hideCue(); dropAmend();
        addRow('operator approved · deny overridden (logged)', 'sf-row--ok');
        addRow('transition <b>allowed</b> → ship', 'sf-row--ok');
        gate.setAttribute('data-verdict', 'allow');
        stamp.textContent = 'ALLOW';
        if (gateT) gateT.textContent = 'human override · recorded in the steering timeline';
        setTerm('ship --run r-4f2a', 'release.tag written');
      }
      function resolveReject() {
        if (resolved) return;
        resolved = true; setButtons(false); hideCue(); dropAmend();
        addRow('run <b>rejected</b> · returned to build', 'sf-row--gate');
        addRow('unit 3 reopened · awaiting a new diff');
        gate.setAttribute('data-verdict', 'deny');
        stamp.textContent = 'DENY';
        if (gateT) gateT.textContent = 'gate stands · nothing shipped';
        setTerm('hold --run r-4f2a', 'held at build');
      }
      function resolveSteer(text) {
        if (resolved) return;
        resolved = true; setButtons(false); hideCue(); dropAmend();
        addRow('amendment applied · <b>' + escapeHtml(text) + '</b>');
        addRow('re-running build · amendment rides the next prompt');
        addRow('policy <b>schema-drift</b> · <b>PASS</b>', 'sf-row--ok');
        addRow('gate <b>build → ship</b> · <b>PASS</b>', 'sf-row--ok');
        gate.setAttribute('data-verdict', 'allow');
        stamp.textContent = 'ALLOW';
        if (gateT) gateT.textContent = 'steered · re-verified against worktree · PASS';
        setTerm('resume --run r-4f2a', 'steered · re-running build');
      }
      function openAmend() {
        if (resolved) return;
        var existing = gate.querySelector('.sg-amend input');
        if (existing) { existing.focus(); existing.select(); return; }
        hideCue();
        var wrap = document.createElement('div');
        wrap.className = 'sg-amend';
        var amInput = document.createElement('input');
        amInput.type = 'text';
        amInput.value = 'add rollback migration + regen schema';
        amInput.setAttribute('aria-label', 'Amendment to steer the next unit');
        var apply = document.createElement('button');
        apply.type = 'button';
        apply.className = 'sg-btn sg-btn--ok';
        apply.textContent = 'Apply ↵';
        wrap.appendChild(amInput);
        wrap.appendChild(apply);
        gate.appendChild(wrap);
        amInput.focus();
        amInput.select();
        function submit() {
          var text = amInput.value.trim();
          if (text) resolveSteer(text);
        }
        apply.addEventListener('click', submit);
        amInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); submit(); }
        });
      }

      gate.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('[data-sg-action]') : null;
        if (!btn || btn.disabled) return;
        var action = btn.getAttribute('data-sg-action');
        if (action === 'approve') resolveApprove();
        else if (action === 'reject') resolveReject();
        else if (action === 'steer') openAmend();
      });

      // Relaunch from the free-text problem — reset + re-stream a fresh run that
      // ends again at the gate, so a visitor can drive their own problem in.
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          workerFlip = (workerFlip + 1) % 2;
          stream(workerFlip === 0 ? 'codex' : 'claude');
          if (input) input.blur();
        });
      }

      // Auto-play the run when the studio scrolls into view (the signature the
      // gate console + workflows sections share). Reduced-motion renders it static.
      var started = false;
      function startOnce() {
        if (started) return; started = true;
        stream('claude');
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { startOnce(); io.disconnect(); }
          });
        }, { threshold: 0.3 });
        io.observe(root);
      } else {
        startOnce();
      }
    })();
  </script>
</Base>

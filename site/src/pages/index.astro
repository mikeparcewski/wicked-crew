---
/**
 * index.astro — the wicked-crew landing page (wc.wickedagile.com).
 *
 * POSITIONING (canonical loop, code-grounded): crew is the GOVERN arc — "the
 * control room for governed agent delivery." You cannot stabilize the harness;
 * crew is the durable system around it. You drive, the gates decide, every
 * decision is audited, and the human stays in command. It drives your own
 * installed CLIs as governed workers through durable, multi-agent workflows
 * where "done" is re-derived from evidence, never self-graded. Intent in,
 * verified work out — on the wicked-core engine. Philosophy: intent-driven
 * development.
 *
 * The daemon (`wicked-crew serve`) is the SUBSTRATE, never the pitch.
 *
 * HONEST BOUNDARIES honored on this page:
 *  - Local-first today (loopback, in-process engine, local workers/bus). The
 *    execution seam is built for a remote runner — gestured, never claimed as
 *    shipped. No remote/cluster/horizontal-scale claim.
 *  - No workflow SELECTOR in the UI yet: the console launches from a free-text
 *    problem. Workflows are data you author + drop in.
 *  - Campaign DAG is engine-real but not a product action — not featured.
 *  - BYO-CLI: crew runs whatever CLI you've authed, under your plan. It has no
 *    billing and manages no subscriptions.
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import '../styles/crew.css';

const title = 'wicked-crew — the control room for governed agent delivery';
const description =
  'wicked-crew is the Govern arc of the wicked loop: the control room for governed agent delivery. Drive, gate, and audit the work; the human stays in command. It drives your own installed CLIs (Claude Code, Antigravity, Codex, local models, any binary) as governed workers in git worktrees, through durable multi-agent workflows where "done" is re-derived from evidence, never self-graded. A dual gate deny-dominates: an approved deterministic check re-verified against the worktree, plus an LLM judge that can fail a gate but can never approve one. Workflows are data you drop in. Crash-resumable by construction. The engine underneath is wicked-core. Runs on the agents and plans you already pay for. Local-first.';
const repo = 'https://github.com/mikeparcewski/wicked-crew';

// The deterministic floor: policies wired in series across a build → ship gate.
const POLICIES = [
  { id: 'contract',      note: 'API contract holds — no breaking change.' },
  { id: 'security',      note: 'No secret, no disallowed dependency.' },
  { id: 'coverage',      note: 'Coverage at or above the approved floor.' },
  { id: 'schema-drift',  note: 'Migration matches the checked-in schema.' },
  { id: 'verdict.json',  note: 'wicked-testing acceptance verdict = PASS.' },
];

// The bring-your-own roster. crew runs whatever CLI you've installed + authed.
// Mirrors the engine's built-in worker registry (claude, agy, codex, copilot,
// opencode, pi — wicked-council/src/registry.rs), plus the two catch-alls that
// keep the roster open-ended. Each is dispatched as a headless CLI subprocess:
// the prompt is substituted into argv ({PROMPT}) and the result is read from
// stdout (wicked-council/src/dispatch.rs).
const WORKERS = [
  { name: 'Claude Code',    cli: 'claude -p',      tag: 'your auth' },
  { name: 'Antigravity',    cli: 'agy run',        tag: 'your login' },
  { name: 'Codex',          cli: 'codex exec',     tag: 'your plan' },
  { name: 'GitHub Copilot', cli: 'copilot -p',     tag: 'your seat' },
  { name: 'opencode',       cli: 'opencode run',   tag: 'your keys' },
  { name: 'Pi',             cli: 'pi -p',          tag: 'your host' },
  { name: 'local model',    cli: 'ollama run …',   tag: 'offline' },
  { name: 'any binary',     cli: './my-agent',     tag: 'your TOML' },
];

// Workflows are DATA — validated JSON, dropped in. Distinct shapes prove it.
const WORKFLOWS = [
  { id: 'feature.json',   phases: ['clarify', 'design', 'test-strategy', 'build', 'test', 'ship'] },
  { id: 'bug.json',       phases: ['reproduce', 'fix', 'test', 'ship'] },
  { id: 'migration.json', phases: ['plan', 'migrate', 'verify', 'ship'] },
];

// Durable lifecycle: the governed track + the stateless worker each phase dispatches.
const LIFECYCLE = [
  { id: 'clarify',       worker: 'claude -p', evidence: 'clarify.md' },
  { id: 'design',        worker: 'claude -p', evidence: 'design.md' },
  { id: 'test-strategy', worker: 'wicked-testing', evidence: 'strategy.md' },
  { id: 'build',         worker: 'codex exec',      evidence: 'diff · build.log' },
  { id: 'test',          worker: 'wicked-testing', evidence: 'verdict.json' },
  { id: 'ship',          worker: 'bash',           evidence: 'release.tag' },
];

// A council: heterogeneous CLIs, each answering in its own isolated sandbox,
// blind to the others. crew fans the SAME question out, parses the votes, and
// synthesizes agreement + divergence. Three real, distinct rounds prove the
// board is heterogeneous — the seats disagree, and deny-dominates the synthesis.
// CLI names mirror the worker registry (WORKERS) so the page stays consistent.
const COUNCIL_ROUNDS = [
  { label: 'contract break', synth: 'rework', line: '2 of 3 → REWORK',
    tail: 'divergence flagged · contract break + missing rollback carried forward',
    seats: [
      { cli: 'claude -p', vote: 'REWORK', note: 'contract break in the delta' },
      { cli: 'codex exec',      vote: 'PASS',   note: 'tests green, diff scoped' },
      { cli: 'local model',    vote: 'REWORK', note: 'missing rollback path' } ] },
  { label: 'all clear', synth: 'pass', line: '3 of 3 → PASS',
    tail: 'unanimous · types intact, coverage +3%, rollback present',
    seats: [
      { cli: 'claude -p', vote: 'PASS', note: 'types check, contract intact' },
      { cli: 'codex exec',      vote: 'PASS', note: 'coverage +3%, diff scoped' },
      { cli: 'local model',    vote: 'PASS', note: 'rollback path present' } ] },
  { label: 'split + abstain', synth: 'rework', line: 'split · 1 REWORK carried',
    tail: 'no majority · one REWORK dominates · one seat abstained on low context',
    seats: [
      { cli: 'claude -p', vote: 'REWORK',  note: 'perf regression in hot path' },
      { cli: 'codex exec',      vote: 'ABSTAIN', note: 'insufficient context to judge' },
      { cli: 'local model',    vote: 'PASS',    note: 'meets the stated spec' } ] },
];

// Gate-console explainer cards. Each card drives the console animation (below).
const GATE_CARDS = [
  { k: 'series',  title: 'Every check is a switch',   line: 'Policies sit in series across a phase gate. Close them all and current reaches the next phase.' },
  { k: 'deny',    title: 'Deny dominates',            line: 'Open one switch and the whole track goes dark. One failing check is the whole answer — not a score you out-vote.' },
  { k: 'agent',   title: 'The judge can veto only',   line: 'An LLM seat sits on the track. It can break it (fail the gate) — it can never be the thing that closes it. No model approves.' },
  { k: 'opt-in',  title: 'Gating is opt-in per phase', line: 'A phase can run ungated. Turn the gate off and the transition passes without evaluation — gating is a choice you make per phase.' },
];
---

<Base title={title} description={description}>
  <Topbar pkg="wicked-crew" repo={repo} />

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="grid-floor" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="kicker">Govern · the wicked loop</div>
        <h1>The control room<br>for <span class="y">governed agent delivery.</span></h1>
        <p class="lede">
          You cannot stabilize the harness — the agents and their models keep changing. <b>wicked-crew is
          the durable control room around them</b>: you <b>drive</b>, the <b>gates</b> decide, every
          decision is <b>audited</b>, and the <b>human stays in command</b>. It runs your own CLIs as
          governed workers through durable, multi-agent workflows where <b>“done” is re-derived from
          evidence</b>, never self-graded. Intent in, verified work out — on the wicked-core engine.
        </p>
        <div class="hero-tags" role="list">
          <span role="listitem">bring your own CLI</span>
          <span role="listitem">can’t self-grade</span>
          <span role="listitem">workflows are data</span>
          <span role="listitem">crash-resumable</span>
          <span role="listitem">local-first</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#gate">Operate the gate ↓</a>
          <a class="btn btn-ghost" href="#get">Install it</a>
        </div>
      </div>

      <!-- Control-room plate: crew DRIVES YOUR CLIs as governed workers → verified out. -->
      <aside class="plate" aria-label="Intent in, governed workers, verified work out">
        <div class="plate-bar">
          <span class="plate-badge">wicked-crew</span>
          <span class="plate-loc">the control room</span>
        </div>
        <div class="plate-flow">
          <div class="pf-in"><span class="pf-k">intent</span><span class="pf-v">“add rate-limiting to the API”</span></div>
          <div class="pf-workers" aria-hidden="true">
            <span class="pf-worker"><i class="pf-dot"></i>claude -p<span class="pf-wt">worktree</span></span>
            <span class="pf-worker"><i class="pf-dot"></i>codex exec<span class="pf-wt">worktree</span></span>
            <span class="pf-worker"><i class="pf-dot"></i>local model<span class="pf-wt">worktree</span></span>
          </div>
          <div class="pf-your">your CLIs · your auth · no shell · isolated worktrees</div>
          <div class="pf-gate" aria-hidden="true">
            <span class="pf-gate-node">gate</span>
            <span class="pf-gate-t">done re-derived from evidence</span>
          </div>
          <div class="pf-out"><span class="pf-stamp">VERIFIED</span><span class="pf-out-t">work out — nothing self-graded</span></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ── Intent-driven development beat ────────────────────────────────── -->
  <section class="idd" aria-labelledby="idd-h">
    <div class="wrap">
      <div class="idd-grid">
        <div class="idd-copy">
          <div class="kicker">Intent-driven development</div>
          <h2 id="idd-h">Spec-driven development’s outcome — without the theater of specs nobody reads.</h2>
          <p>
            You state <b>intent</b>. crew drives a governed workflow to a <b>verified result</b> — deriving
            “done” from evidence at every gate instead of trusting a claim. No ceremony, no shelfware spec.
          </p>
        </div>
        <div class="idd-flow" aria-hidden="true">
          <span class="idd-chip idd-chip--in">intent</span>
          <span class="idd-arrow">→</span>
          <span class="idd-chip idd-chip--mid">governed workflow</span>
          <span class="idd-arrow">→</span>
          <span class="idd-chip idd-chip--out">verified result</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bring your own agent (BYO-CLI) ────────────────────────────────── -->
  <section class="byo" aria-labelledby="byo-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">Bring your own agent</div>
        <h2 id="byo-h">crew runs the CLIs you already have.</h2>
        <p class="sec-sub">
          Not a new model, not a subscription. crew dispatches your <b>installed</b> coding CLIs — Claude
          Code, Antigravity, Codex, Copilot, opencode, Pi, a local model, or any binary — as <b>no-shell workers in isolated git worktrees</b>,
          under <b>your own auth and plan</b>. The roster is data: a manifest plus a
          <code>workers.toml</code> you own.
        </p>
      </div>

      <div class="byo-grid" data-byo>
        {WORKERS.map((w, i) => (
          <button type="button" class:list={['byo-card', { 'is-active': i === 0 }]} data-byo-card data-i={i}>
            <span class="byo-dot" aria-hidden="true"></span>
            <span class="byo-name">{w.name}</span>
            <span class="byo-cli">{w.cli}</span>
            <span class="byo-tag">{w.tag}</span>
          </button>
        ))}
      </div>

      <div class="byo-stage" data-byo-stage>
        <div class="byo-stage-head">
          <span class="byo-stage-k">dispatched as a governed worker</span>
          <span class="byo-stage-badge" data-byo-badge>Claude Code</span>
        </div>
        <div class="byo-stage-row">
          <code data-byo-cmd>claude -p</code>
          <span class="byo-stage-arr">→ runs in →</span>
          <span class="byo-stage-wt">.worktrees/run-4f2a · no shell · read-scoped</span>
        </div>
        <p class="byo-stage-note">
          Same governed lifecycle wraps every worker. Swap the roster in <code>workers.toml</code> —
          crew treats them all as stateless subprocesses it owns.
        </p>
      </div>
    </div>
  </section>

  <!-- ── THE GATE CONSOLE (signature) ──────────────────────────────────── -->
  <!-- ONE thing: a deterministic series-circuit gate that AUTO-ANIMATES, driven
       by whichever explainer card is active (the animation flips the switches
       that card describes). Clicking a switch STOPS the animation so the visitor
       can play manually. Full-width — no sticky subscroll, no cutoff.
       True idea preserved: deny-dominates series circuit; an LLM seat can veto
       but never approve (deterministic floor + veto-only agent seat); gating is
       opt-in per phase. -->
  <section class="console-sec" id="gate" aria-labelledby="gc-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">The gate console · watch it, then drive it</div>
        <h2 id="gc-h">“Done” is re-derived — and no model can approve it.</h2>
        <p class="sec-sub">
          A real transition — <b>build → ship</b> — behind a dual gate that <b>deny-dominates</b>: an
          approved deterministic check re-verified against the worktree, plus an LLM judge that can
          <b>fail</b> a gate but can <b>never approve</b> one. It plays itself. Click a switch to take over.
        </p>
      </div>

      <div class="gc" data-gc>
        <div class="gc-topbar">
          <span class="gc-phase" data-gc-phase>gate · build → ship · <b>enabled</b></span>
          <span class="gc-hint" data-gc-hint aria-hidden="true">☝ Click any switch to drive it</span>
          <span class="gc-mode" data-gc-mode>▶ demo playing</span>
        </div>

        <!-- Series circuit: source → [seg, switch] × N → agent seat → seg → dest -->
        <div class="gc-rail" role="group" aria-label="Series-circuit dual gate: build to ship">
          <div class="gc-node gc-src">
            <span class="gc-node-k">phase</span><span class="gc-node-v">build</span>
          </div>

          {POLICIES.map((p) => (
            <>
              <span class="gc-seg" data-seg></span>
              <button
                type="button"
                class="gc-sw"
                data-sw
                data-policy={p.id}
                data-kind="floor"
                aria-pressed="true"
                aria-label={`Deterministic policy ${p.id}`}
                title={p.note}
              >
                <span class="gc-sw-well" aria-hidden="true"><span class="gc-sw-lever"></span></span>
                <span class="gc-sw-name">{p.id}</span>
                <span class="gc-sw-state" data-state>PASS</span>
              </button>
            </>
          ))}

          <span class="gc-seg" data-seg></span>
          <button
            type="button"
            class="gc-sw gc-sw--agent"
            data-sw
            data-policy="llm-judge"
            data-kind="agent"
            aria-pressed="true"
            aria-label="LLM judge seat: veto only, can never approve"
            title="An LLM judge — it can veto (fail the gate), never approve."
          >
            <span class="gc-sw-well" aria-hidden="true"><span class="gc-sw-lever"></span></span>
            <span class="gc-sw-name">llm-judge</span>
            <span class="gc-sw-state" data-state>ABSTAIN</span>
          </button>

          <span class="gc-seg" data-seg></span>
          <div class="gc-node gc-dst" data-dst>
            <span class="gc-node-k">next</span><span class="gc-node-v">ship</span>
          </div>
        </div>

        <div class="gc-panel">
          <div class="gc-verdict" data-verdict aria-live="polite">
            <span class="gc-v-stamp" data-stamp>ALLOW</span>
            <div class="gc-v-body">
              <span class="gc-v-line" data-vline>Every check closed — current reaches ship. Transition allowed.</span>
              <span class="gc-v-sub">deterministic floor re-verified · no LLM approves · held for human on any DENY</span>
            </div>
          </div>

          <div class="gc-actions">
            <button type="button" class="gc-btn gc-argue" data-argue>Let the model argue its case →</button>
          </div>

          <div class="gc-plea" data-plea hidden aria-live="polite"></div>
        </div>
      </div>

      <!-- Explainer cards drive the console. Click one to play its point. -->
      <ol class="gc-cards" data-gc-cards>
        {GATE_CARDS.map((c, i) => (
          <li>
            <button type="button" class:list={['gc-card', { 'is-active': i === 0 }]} data-gc-card data-card={c.k} data-i={i}>
              <span class="gc-card-n">{i + 1}</span>
              <span class="gc-card-t">{c.title}</span>
              <span class="gc-card-l">{c.line}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Workflows are data ────────────────────────────────────────────── -->
  <section class="wf" aria-labelledby="wf-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">Workflows are data, not code</div>
        <h2 id="wf-h">Drop a <code>*.json</code>. It’s a workflow.</h2>
        <p class="sec-sub">
          feature, bug, migration — each ships as <b>validated JSON</b>. Add or override one by dropping a
          file in; the plan is <b>acyclic-validated</b> with <b>loud, per-file errors</b>. No recompile, no
          plugin. It auto-cycles the defs below — click one to pin it.
        </p>
      </div>

      <div class="wf-layout">
        <div class="wf-files" data-wf role="tablist" aria-label="Workflow definitions">
          {WORKFLOWS.map((w, i) => (
            <button type="button" role="tab" class:list={['wf-file', { 'is-active': i === 0 }]} data-wf-file data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="wf-file-ic" aria-hidden="true">{'{ }'}</span>
              <span class="wf-file-name">{w.id}</span>
              <span class="wf-file-count">{w.phases.length} phases</span>
            </button>
          ))}
          <div class="wf-drop" aria-hidden="true">+ drop <code>your-flow.json</code></div>
        </div>

        <div class="wf-preview" data-wf-preview>
          <div class="wf-preview-bar">
            <span class="wf-preview-name" data-wf-name>feature.json</span>
            <span class="wf-preview-ok" data-wf-ok>✓ acyclic · validated</span>
          </div>
          <div class="wf-phases" data-wf-phases></div>
        </div>
      </div>

      <div class="wf-status" data-wf-status>
        <button type="button" class="wf-status-btn is-playing" data-wf-toggle aria-live="polite">
          <span class="wf-status-ic" aria-hidden="true">▶</span>
          <span class="wf-status-txt" data-wf-status-txt>auto-playing · click a workflow to pin it</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ── Durable lifecycle rail — crash-resumable by construction ──────── -->
  <section class="rail-sec" aria-labelledby="rail-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">Durable by construction</div>
        <h2 id="rail-h">Crash it mid-run. It resumes to the exact phase.</h2>
        <p class="sec-sub">
          A <b>single-writer store</b> and <b>durable cursors</b> give <b>exactly-once effect over
          at-least-once delivery</b>. Interrupted runs are <b>automatically re-driven on restart</b>. Hover
          to pause, click a phase to jump, or <b>kill the engine</b> and watch it come back where it left off.
        </p>
      </div>

      <div class="rail" data-rail>
        <div class="rail-track">
          {LIFECYCLE.map((ph, i) => (
            <>
              {i > 0 && (
                <span class="rail-gate" data-gate aria-hidden="true"><i>◇</i></span>
              )}
              <button
                type="button"
                class="rail-phase"
                data-phase
                data-i={i}
                data-worker={ph.worker}
                data-evidence={ph.evidence}
                aria-label={`Phase ${ph.id}`}
              >
                <span class="rail-dot" aria-hidden="true"></span>
                <span class="rail-name">{ph.id}</span>
              </button>
            </>
          ))}
          <span class="rail-token" data-token aria-hidden="true"></span>
        </div>

        <div class="rail-dock">
          <div class="dock-head">
            <span class="dock-k">dispatched worker</span>
            <button type="button" class="dock-crash" data-crash>⏻ Kill &amp; resume</button>
          </div>
          <div class="dock-row">
            <span class="dock-worker" data-dock-worker>claude&nbsp;--print</span>
            <span class="dock-arr">→ returns →</span>
            <span class="dock-evidence" data-dock-evidence>clarify.md</span>
          </div>
          <div class="dock-note" data-dock-note>
            checkpoint written · single-writer store · phase=<b data-dock-phase>clarify</b>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The council — heterogeneous CLIs, deliberating in isolation ───── -->
  <section class="council" aria-labelledby="council-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">The council</div>
        <h2 id="council-h">Many CLIs. Separate sandboxes. One synthesis.</h2>
        <p class="sec-sub">
          Fan the same question to heterogeneous CLIs — each answers in <b>its own isolated sandbox</b>, blind
          to the others. crew parses the votes and synthesizes agreement and divergence. That seat diversity
          is the machinery behind <b>evaluator ≠ creator</b>.
        </p>
      </div>

      <div class="council-stage" data-council>
        <div class="council-seats">
          {COUNCIL_ROUNDS[0].seats.map((m, i) => (
            <div class:list={['council-seat', `is-${m.vote.toLowerCase()}`]} data-seat data-i={i}>
              <span class="cs-cli">{m.cli}</span>
              <span class="cs-vote">{m.vote}</span>
              <span class="cs-note">{m.note}</span>
            </div>
          ))}
        </div>
        <div class="council-synth" data-council-synth data-synth="rework">
          <span class="cy-k">synthesized</span>
          <span class="cy-v" data-cy-line>2 of 3 → <b>REWORK</b></span>
          <span class="cy-t" data-cy-tail>divergence flagged · contract break + missing rollback carried forward</span>
        </div>
      </div>

      <!-- Round selector — the board auto-cycles three real, distinct rounds;
           click one (or any seat) to pin it, click again to resume. -->
      <div class="council-rounds" data-council-rounds role="tablist" aria-label="Council rounds">
        {COUNCIL_ROUNDS.map((r, i) => (
          <button type="button" role="tab" class:list={['council-round', { 'is-active': i === 0 }]} data-round data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>{i + 1} · {r.label}</button>
        ))}
        <span class="council-status" data-council-status>auto-cycling · click a round to pin</span>
      </div>
    </div>
  </section>

  <!-- ── The driving interface — the studio, built into crew ───────────── -->
  <section class="studio" aria-labelledby="studio-h">
    <div class="wrap">
      <div class="sec-head sec-head--wide">
        <div class="kicker">A real driving interface</div>
        <h2 id="studio-h">The studio — launch, watch, and steer a run.</h2>
        <p class="sec-sub">
          A browser console built into crew. Launch a run from a <b>free-text problem</b>, watch a
          <b>live event feed</b> and <b>per-unit transcript</b>, drive an <b>embedded governed terminal</b>,
          and resolve steering gates — <b>approve</b>, <b>steer with an amendment</b>, or <b>reject</b>.
        </p>
      </div>


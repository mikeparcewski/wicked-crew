  <!-- ── Workflows-as-data: AUTO-PLAY the defs, click one to pin ────────── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-wf]');
      var preview = document.querySelector('[data-wf-preview]');
      if (!root || !preview) return;
      var files = Array.prototype.slice.call(root.querySelectorAll('[data-wf-file]'));
      var nameEl = preview.querySelector('[data-wf-name]');
      var phasesEl = preview.querySelector('[data-wf-phases]');
      var wfSection = root.closest('.wf') || root;
      var toggle = wfSection.querySelector('[data-wf-toggle]');
      var toggleTxt = wfSection.querySelector('[data-wf-status-txt]');
      var toggleIc = toggle && toggle.querySelector('.wf-status-ic');
      var DEFS = [
        { id: 'feature.json',   phases: ['clarify', 'design', 'test-strategy', 'build', 'test', 'ship'] },
        { id: 'bug.json',       phases: ['reproduce', 'fix', 'test', 'ship'] },
        { id: 'migration.json', phases: ['plan', 'migrate', 'verify', 'ship'] },
      ];
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var STEP = 3000;
      var cur = 0, timer = null, pinned = false, started = false;

      function render(i) {
        cur = i;
        var d = DEFS[i] || DEFS[0];
        files.forEach(function (f, j) { f.classList.toggle('is-active', j === i); f.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
        if (nameEl) nameEl.textContent = d.id;
        if (!phasesEl) return;
        phasesEl.innerHTML = '';
        d.phases.forEach(function (p, k) {
          if (k > 0) {
            var arr = document.createElement('span');
            arr.className = 'wf-arr'; arr.setAttribute('aria-hidden', 'true'); arr.textContent = '→';
            phasesEl.appendChild(arr);
          }
          var chip = document.createElement('span');
          chip.className = 'wf-phase';
          chip.textContent = p;
          chip.style.animationDelay = (k * 55) + 'ms';
          phasesEl.appendChild(chip);
        });
      }
      function setStatus() {
        if (!toggle) return;
        toggle.classList.toggle('is-playing', !pinned);
        toggle.classList.toggle('is-pinned', pinned);
        if (toggleIc) toggleIc.textContent = pinned ? '⏸' : '▶';
        if (toggleTxt) toggleTxt.textContent = pinned
          ? 'pinned ' + (DEFS[cur] || DEFS[0]).id + ' · click to resume auto-play'
          : 'auto-playing · click a workflow to pin it';
      }
      function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }
      function play() {
        pinned = false; setStatus();
        stopTimer();
        if (reduced) return; // honor reduced-motion: no auto-advance
        timer = setInterval(function () { render((cur + 1) % DEFS.length); }, STEP);
      }
      function pin(i) {
        pinned = true; stopTimer(); render(i); setStatus();
      }
      function startOnce() {
        if (started) return; started = true;
        render(0); setStatus();
        if (!pinned) play();
      }

      files.forEach(function (f, i) { f.addEventListener('click', function () { pin(i); }); });
      if (toggle) toggle.addEventListener('click', function () {
        if (pinned) play(); else pin(cur);
      });

      // Start when the section scrolls into view (animate-then-pause signature).
      render(0); setStatus();
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { startOnce(); io.disconnect(); }
          });
        }, { threshold: 0.35 });
        io.observe(wfSection);
      } else {
        startOnce();
      }
    })();
  </script>

  <!-- ── Lifecycle rail: run token advance, worker dock, crash + resume ──── -->
  <script is:inline>
    (function () {
      var rail = document.querySelector('[data-rail]');
      if (!rail) return;
      var phases = Array.prototype.slice.call(rail.querySelectorAll('[data-phase]'));
      var gates = Array.prototype.slice.call(rail.querySelectorAll('[data-gate]'));
      var token = rail.querySelector('[data-token]');
      var dWorker = rail.querySelector('[data-dock-worker]');
      var dEvidence = rail.querySelector('[data-dock-evidence]');
      var dPhase = rail.querySelector('[data-dock-phase]');
      var crashBtn = rail.querySelector('[data-crash]');
      if (!phases.length || !token) return;

      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var cur = 0, timer = null, paused = false;

      function place() {
        var p = phases[cur];
        var dot = p.querySelector('.rail-dot') || p;
        var trackEl = rail.querySelector('.rail-track');
        var pr = dot.getBoundingClientRect();
        var rr = trackEl.getBoundingClientRect();
        token.style.left = (pr.left - rr.left + trackEl.scrollLeft + pr.width / 2) + 'px';
        token.style.top = (pr.top - rr.top + pr.height / 2) + 'px';
      }
      function render() {
        phases.forEach(function (p, i) {
          p.classList.toggle('is-now', i === cur);
          p.classList.toggle('is-done', i < cur);
        });
        gates.forEach(function (g, i) { g.classList.toggle('is-cleared', i < cur); });
        var p = phases[cur];
        if (dWorker) dWorker.textContent = p.getAttribute('data-worker');
        if (dEvidence) dEvidence.textContent = p.getAttribute('data-evidence');
        if (dPhase) dPhase.textContent = p.querySelector('.rail-name').textContent;
        if (dEvidence) { dEvidence.classList.remove('pop'); void dEvidence.offsetWidth; dEvidence.classList.add('pop'); }
        place();
      }
      function advance() { if (paused) return; cur = (cur + 1) % phases.length; render(); }
      function start() {
        if (reduced) { cur = 3; render(); return; }
        if (timer) clearInterval(timer);
        timer = setInterval(advance, 2000);
      }
      phases.forEach(function (p, i) { p.addEventListener('click', function () { cur = i; render(); }); });
      rail.addEventListener('pointerenter', function () { paused = true; });
      rail.addEventListener('pointerleave', function () { paused = false; });
      if (crashBtn) crashBtn.addEventListener('click', function () {
        var was = cur;
        rail.classList.add('is-crashed');
        if (dPhase) dPhase.textContent = '— (engine down)';
        setTimeout(function () {
          rail.classList.remove('is-crashed');
          cur = was;
          render();
          var note = rail.querySelector('[data-dock-note]');
          if (note) { note.classList.remove('flash'); void note.offsetWidth; note.classList.add('flash'); }
        }, 900);
      });
      window.addEventListener('resize', place);
      render();
      start();
    })();
  </script>

  <!-- ── The council: AUTO-CYCLE heterogeneous rounds, click one to pin ──── -->
  <script is:inline>
    (function () {
      var stage = document.querySelector('[data-council]');
      if (!stage) return;
      var section = stage.closest('.council') || stage;
      var seats = Array.prototype.slice.call(stage.querySelectorAll('[data-seat]'));
      var synthEl = stage.querySelector('[data-council-synth]');
      var lineEl = stage.querySelector('[data-cy-line]');
      var tailEl = stage.querySelector('[data-cy-tail]');
      var rounds = Array.prototype.slice.call(section.querySelectorAll('[data-round]'));
      var statusEl = section.querySelector('[data-council-status]');
      if (!seats.length || !rounds.length) return;

      // Three real, distinct rounds — mirrors COUNCIL_ROUNDS in the frontmatter.
      // CLI names match the worker registry so the board stays consistent.
      var ROUNDS = [
        { synth: 'rework', line: '2 of 3 → REWORK',
          tail: 'divergence flagged · contract break + missing rollback carried forward',
          seats: [
            { vote: 'REWORK', note: 'contract break in the delta' },
            { vote: 'PASS',   note: 'tests green, diff scoped' },
            { vote: 'REWORK', note: 'missing rollback path' } ] },
        { synth: 'pass', line: '3 of 3 → PASS',
          tail: 'unanimous · types intact, coverage +3%, rollback present',
          seats: [
            { vote: 'PASS', note: 'types check, contract intact' },
            { vote: 'PASS', note: 'coverage +3%, diff scoped' },
            { vote: 'PASS', note: 'rollback path present' } ] },
        { synth: 'rework', line: 'split · 1 REWORK carried',
          tail: 'no majority · one REWORK dominates · one seat abstained on low context',
          seats: [
            { vote: 'REWORK',  note: 'perf regression in hot path' },
            { vote: 'ABSTAIN', note: 'insufficient context to judge' },
            { vote: 'PASS',    note: 'meets the stated spec' } ] },
      ];

      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var STEP = 3200;
      var cur = 0, timer = null, pinned = false, started = false;

      function boldVerdict(txt) {
        return txt.replace(/REWORK/g, '<b>REWORK</b>').replace(/PASS/g, '<b>PASS</b>');
      }

      function render(i, animate) {
        var r = ROUNDS[i] || ROUNDS[0];
        cur = i;
        seats.forEach(function (seatEl, j) {
          var s = r.seats[j];
          if (!s) return;
          seatEl.className = 'council-seat is-' + s.vote.toLowerCase(); // border/bg swaps via CSS transition
          var voteEl = seatEl.querySelector('.cs-vote');
          var noteEl = seatEl.querySelector('.cs-note');
          if (animate && !reduced) {
            if (voteEl) voteEl.style.opacity = '0';
            if (noteEl) noteEl.style.opacity = '0';
            setTimeout(function () {
              if (voteEl) { voteEl.textContent = s.vote; voteEl.style.opacity = '1'; }
              if (noteEl) { noteEl.textContent = s.note; noteEl.style.opacity = '1'; }
            }, 120);
          } else {
            if (voteEl) { voteEl.textContent = s.vote; voteEl.style.opacity = '1'; }
            if (noteEl) { noteEl.textContent = s.note; noteEl.style.opacity = '1'; }
          }
        });
        if (synthEl) synthEl.setAttribute('data-synth', r.synth);
        if (lineEl) lineEl.innerHTML = boldVerdict(r.line);
        if (tailEl) tailEl.textContent = r.tail;
        rounds.forEach(function (b, j) {
          b.classList.toggle('is-active', j === i);
          b.setAttribute('aria-selected', j === i ? 'true' : 'false');
        });
      }

      function setStatus() {
        if (!statusEl) return;
        if (reduced && !pinned) { statusEl.textContent = 'reduced motion · click a round to view'; return; }
        statusEl.textContent = pinned
          ? 'pinned round ' + (cur + 1) + ' · click it again to resume'
          : 'auto-cycling · click a round to pin';
      }
      function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }
      function play() {
        pinned = false; stopTimer(); setStatus();
        if (reduced) return; // honor reduced-motion: no auto-advance
        timer = setInterval(function () { render((cur + 1) % ROUNDS.length, true); }, STEP);
      }
      function pin(i) { pinned = true; stopTimer(); render(i, true); setStatus(); }
      function startOnce() {
        if (started) return; started = true;
        render(0, false); setStatus();
        if (!pinned && !reduced) play();
      }

      // Click a round to pin it; click the pinned round again to resume cycling.
      rounds.forEach(function (b, i) {
        b.addEventListener('click', function () {
          if (reduced) { render(i, false); setStatus(); return; }
          if (pinned && cur === i) play(); else pin(i);
        });
      });
      // Click any seat to freeze the board on the current round (inspect it).
      seats.forEach(function (seatEl) {
        seatEl.addEventListener('click', function () { if (!reduced) pin(cur); });
      });

      // Start the auto-cycle when the section scrolls into view.
      render(0, false); setStatus();
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { startOnce(); io.disconnect(); }
          });
        }, { threshold: 0.35 });
        io.observe(section);
      } else {
        startOnce();
      }
    })();
  </script>

  <!-- ── The studio: hands-on console — launch, watch the feed, resolve the gate ── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-studio]');
      if (!root) return;
      var feed = root.querySelector('[data-studio-feed]');
      var gate = root.querySelector('[data-studio-gate]');
      var stamp = root.querySelector('[data-sg-stamp]');
      var gateT = root.querySelector('[data-sg-t]');
      var termEl = root.querySelector('[data-studio-term]');
      var form = root.querySelector('[data-studio-launch]');
      var input = root.querySelector('[data-studio-input]');
      if (!feed || !gate || !stamp) return;

      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var STEP = 700;
      var timer = null;
      var resolved = false;
      var runSeq = 0;      // guards a stale stream after a relaunch
      var workerFlip = 0;  // cycles the dispatched worker on relaunch

      function escapeHtml(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function clearFeed() {
        var rows = feed.querySelectorAll('.sf-row');
        for (var i = 0; i < rows.length; i++) rows[i].parentNode.removeChild(rows[i]);
      }
      function addRow(html, cls) {
        var row = document.createElement('span');
        row.className = 'sf-row' + (cls ? ' ' + cls : '');
        row.innerHTML = html;
        feed.appendChild(row);
        feed.scrollTop = feed.scrollHeight;
        return row;
      }
      function setTerm(cmd, comment) {
        if (!termEl) return;
        termEl.innerHTML = '<span class="st-p">crew ›</span> ' + cmd +
          (comment ? ' <span class="st-c"># ' + comment + '</span>' : '');
      }
      function setButtons(enabled) {
        var btns = gate.querySelectorAll('[data-sg-action]');
        for (var i = 0; i < btns.length; i++) btns[i].disabled = !enabled;
      }
      function hideCue() {
        var cue = gate.querySelector('[data-sg-cue]');
        if (cue) cue.parentNode.removeChild(cue);
      }
      function dropAmend() {
        var amend = gate.querySelector('.sg-amend');
        if (amend) amend.parentNode.removeChild(amend);
      }
      function hideGate() {
        hideCue(); dropAmend();
        gate.hidden = true;
        gate.removeAttribute('data-verdict');
        stamp.textContent = 'DENY';
        if (gateT) gateT.textContent = 'schema-drift · re-verified against worktree';
        setButtons(true);
        resolved = false;
      }
      function showGate() {
        gate.hidden = false;
        gate.setAttribute('data-verdict', 'deny');
        stamp.textContent = 'DENY';
        if (gateT) gateT.textContent = 'schema-drift · re-verified against worktree';
        setButtons(true);
        resolved = false;
        hideCue();
        var cue = document.createElement('span');
        cue.className = 'sg-cue';
        cue.setAttribute('data-sg-cue', '');
        cue.textContent = '☝ Resolve the gate';
        gate.appendChild(cue);
      }

      // Feed steps grounded in the real lifecycle (build → ship) + policy floor.
      function steps(worker) {
        return [
          { h: 'run <b>r-4f2a</b> launched · workflow <b>feature.json</b>' },
          { h: 'phase <b>build</b> · worker <b>' + worker + '</b> · .worktrees/run-4f2a' },
          { h: 'unit <b>3/5</b> · diff captured · build.log green' },
          { h: 'gate <b>build → ship</b> · re-verifying against worktree' },
          { h: 'policy <b>schema-drift</b> · <b>FAIL</b> — migration ≠ checked-in schema', c: 'sf-row--gate' },
          { h: 'gate held · <b>steering decision required</b>', c: 'sf-row--gate' }
        ];
      }
      function stream(worker) {
        if (timer) { clearTimeout(timer); timer = null; }
        runSeq++;
        var seq = runSeq;
        clearFeed();
        hideGate();
        setTerm('attach --run r-4f2a', 'governed terminal');
        var list = steps(worker);
        if (reduced) {
          for (var i = 0; i < list.length; i++) addRow(list[i].h, list[i].c);
          showGate();
          return;
        }
        var idx = 0;
        (function tick() {
          if (seq !== runSeq) return;
          if (idx >= list.length) { showGate(); return; }
          addRow(list[idx].h, list[idx].c);
          idx++;
          timer = setTimeout(tick, STEP);
        })();
      }

      // --- gate resolutions: the human takes the wheel (no model approves) ---
      function resolveApprove() {
        if (resolved) return;
        resolved = true; setButtons(false); hideCue(); dropAmend();
        addRow('operator approved · deny overridden (logged)', 'sf-row--ok');
        addRow('transition <b>allowed</b> → ship', 'sf-row--ok');
        gate.setAttribute('data-verdict', 'allow');
        stamp.textContent = 'ALLOW';
        if (gateT) gateT.textContent = 'human override · recorded in the steering timeline';
        setTerm('ship --run r-4f2a', 'release.tag written');
      }
      function resolveReject() {
        if (resolved) return;
        resolved = true; setButtons(false); hideCue(); dropAmend();
        addRow('run <b>rejected</b> · returned to build', 'sf-row--gate');
        addRow('unit 3 reopened · awaiting a new diff');
        gate.setAttribute('data-verdict', 'deny');
        stamp.textContent = 'DENY';
        if (gateT) gateT.textContent = 'gate stands · nothing shipped';
        setTerm('hold --run r-4f2a', 'held at build');
      }
      function resolveSteer(text) {
        if (resolved) return;
        resolved = true; setButtons(false); hideCue(); dropAmend();
        addRow('amendment applied · <b>' + escapeHtml(text) + '</b>');
        addRow('re-running build · worker codex exec');
        addRow('policy <b>schema-drift</b> · <b>PASS</b>', 'sf-row--ok');
        addRow('gate <b>build → ship</b> · <b>PASS</b>', 'sf-row--ok');
        gate.setAttribute('data-verdict', 'allow');
        stamp.textContent = 'ALLOW';
        if (gateT) gateT.textContent = 'steered · re-verified against worktree · PASS';
        setTerm('resume --run r-4f2a', 'steered · re-running build');
      }
      function openAmend() {
        if (resolved) return;
        var existing = gate.querySelector('.sg-amend input');
        if (existing) { existing.focus(); existing.select(); return; }
        hideCue();
        var wrap = document.createElement('div');
        wrap.className = 'sg-amend';
        var amInput = document.createElement('input');
        amInput.type = 'text';
        amInput.value = 'add rollback migration + regen schema';
        amInput.setAttribute('aria-label', 'Amendment to steer the next unit');
        var apply = document.createElement('button');
        apply.type = 'button';
        apply.className = 'sg-btn sg-btn--ok';
        apply.textContent = 'Apply ↵';
        wrap.appendChild(amInput);
        wrap.appendChild(apply);
        gate.appendChild(wrap);
        amInput.focus();
        amInput.select();
        function submit() {
          var text = amInput.value.trim();
          if (text) resolveSteer(text);
        }
        apply.addEventListener('click', submit);
        amInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); submit(); }
        });
      }

      gate.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('[data-sg-action]') : null;
        if (!btn || btn.disabled) return;
        var action = btn.getAttribute('data-sg-action');
        if (action === 'approve') resolveApprove();
        else if (action === 'reject') resolveReject();
        else if (action === 'steer') openAmend();
      });

      // Relaunch from the free-text problem — reset + re-stream a fresh run that
      // ends again at the gate, so a visitor can drive their own problem in.
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          workerFlip = (workerFlip + 1) % 2;
          stream(workerFlip === 0 ? 'codex exec' : 'claude -p');
          if (input) input.blur();
        });
      }

      // Auto-play the run when the studio scrolls into view (the signature the
      // gate console + workflows sections share). Reduced-motion renders it static.
      var started = false;
      function startOnce() {
        if (started) return; started = true;
        stream('codex exec');
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { startOnce(); io.disconnect(); }
          });
        }, { threshold: 0.3 });
        io.observe(root);
      } else {
        startOnce();
      }
    })();
  </script>

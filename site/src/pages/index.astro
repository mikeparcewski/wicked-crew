---
/**
 * index.astro — the wicked-crew landing page (wc.wickedagile.com).
 *
 * Concept: THE GOVERNOR. wicked-crew is the deterministic adult in the room —
 * it owns the workflow without owning the work. The page is staged as a
 * governance control room / switchboard whose emotional spine is one felt
 * truth: there is no LLM on the gate path, so nothing you (or the model) does
 * can sweet-talk it. Deny-dominates is rendered as a SERIES CIRCUIT the visitor
 * OPERATES — every policy is a switch on a track from the current phase to the
 * next; current only flows (ALLOW) when every switch is closed; a single open
 * switch (DENY) breaks the whole track.
 *
 * Signature interaction: THE GATE CONSOLE — a real deterministic gate the
 * visitor drives (DOM/SVG + vanilla JS, no canvas, cannot render empty). Flip
 * five policy switches; the series-circuit track lights amber and completes to
 * the next phase only when ALL are closed; the verdict recomputes instantly
 * under deny-dominates. A "Let the model argue its case" button plays a
 * persuasive plea and moves the verdict by exactly zero.
 *
 * Honesty (per CANONICAL-MESSAGING.md, resolved 2026-07-08):
 *  - crew = an EXTERNAL daemon + CLI; it never runs inside a coding agent and
 *    never writes code. v0.2.0, published to npm as `wicked-crew`.
 *  - the orchestration engine lives in wicked-core; the daemon is a thin
 *    REST + WebSocket bridge that also bundles + serves the studio browser
 *    console (a crew-served React SPA, not separately published).
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import '../styles/crew.css';

const title = 'wicked-crew — the daemon that governs multi-phase AI workflows';
const description = 'wicked-crew is a standalone external orchestrator — a daemon plus CLI — for governed, multi-phase AI development. It runs above your coding agents, never inside them, treating AI CLIs as stateless worker subprocesses while it owns the phase lifecycle (clarify → design → test-strategy → build → test → ship), deterministic deny-dominates gates with no LLM on the gate path, SQLite crash-checkpointing, and evidence. Drive it headless over CLI + REST/WS, or through the browser console it serves same-origin on localhost. Local-first, no cloud, no accounts.';
const repo = 'https://github.com/mikeparcewski/wicked-crew';

// The five policies wired in series across the staged build → ship transition.
// `open` marks the one that ships DENYed by default, so the console renders a
// real (never empty) held-verdict state and hints at the interaction.
const POLICIES = [
  { id: 'contract',        note: 'API contract holds — no breaking change.' },
  { id: 'security-policy', note: 'No secret, no disallowed dependency.' },
  { id: 'coverage-floor',  note: 'Coverage at or above the floor.' },
  { id: 'schema-drift',    note: 'Migration diverged from the checked-in schema.', open: true },
  { id: 'verdict.json',    note: 'wicked-testing acceptance verdict = PASS.' },
];

// Lifecycle: the governed track, and which stateless worker each phase dispatches.
const LIFECYCLE = [
  { id: 'clarify',       worker: 'claude --print', evidence: 'clarify.md' },
  { id: 'design',        worker: 'claude --print', evidence: 'design.md' },
  { id: 'test-strategy', worker: 'wicked-testing', evidence: 'strategy.md' },
  { id: 'build',         worker: 'codex run',      evidence: 'diff · build.log' },
  { id: 'test',          worker: 'wicked-testing', evidence: 'verdict.json' },
  { id: 'ship',          worker: 'bash',           evidence: 'release.tag' },
];
---

<Base title={title} description={description}>
  <Topbar pkg="wicked-crew" repo={repo} />

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="grid-floor" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="kicker">External orchestration daemon · the governor</div>
        <h1>Own the workflow.<br><span class="y">Not the work.</span></h1>
        <p class="lede">
          wicked-crew is the <b>deterministic adult in the room</b> — an external daemon that owns the
          phase lifecycle and the gates, and dispatches your AI CLIs as stateless workers. There is
          <b>no LLM on the gate path</b>, so nothing you or the model does can talk it past a
          <code>DENY</code>. Governance here is physics, not a judgment call.
        </p>
        <div class="hero-tags" role="list">
          <span role="listitem">deny-dominates gates</span>
          <span role="listitem">no LLM on the gate path</span>
          <span role="listitem">crash-resumable</span>
          <span role="listitem">local-first</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#gate">Operate the gate ↓</a>
          <a class="btn btn-ghost" href="#get">Run the daemon</a>
        </div>
      </div>

      <!-- Compact live governor plate: build → ship, one gate mid-transition holding a DENY. -->
      <aside class="plate" aria-label="A governed transition holding a DENY">
        <div class="plate-bar">
          <span class="plate-badge">gate · deny-dominates</span>
          <span class="plate-loc">localhost:7701</span>
        </div>
        <div class="plate-rail" aria-hidden="true">
          <span class="pr-node is-from">build</span>
          <span class="pr-wire"><i></i></span>
          <span class="pr-gate is-deny" title="held">✕</span>
          <span class="pr-wire is-dead"></span>
          <span class="pr-node is-to">ship</span>
        </div>
        <div class="plate-verdict">
          <span class="plate-stamp">DENY</span>
          <span class="plate-note">1 of 5 policies open · held for human review</span>
        </div>
        <div class="plate-hint">Flip the switches below ↓</div>
      </aside>
    </div>
  </section>

  <!-- ── THE GATE CONSOLE (signature interactive) ──────────────────────── -->
  <!-- A real deterministic gate the visitor operates. Deny-dominates rendered
       as a SERIES CIRCUIT: every policy is a switch on the track from build to
       ship; current flows (ALLOW) only when every switch is closed; a single
       open switch (DENY) breaks the track. DOM/SVG + vanilla JS, no canvas —
       it cannot render empty. Ships a held DENY state (schema-drift open). -->
  <section class="console-sec" id="gate" aria-labelledby="gc-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker">The gate console · operate it</div>
        <h2 id="gc-h">Flip the policies. Deny still dominates.</h2>
        <p class="sec-sub">
          One real transition — <b>build → ship</b> — gated by five policies wired <b>in series</b>.
          Close them all and current reaches the next phase. Leave one open and the whole track goes
          dark. Then press <b>“let the model argue”</b> and watch it move the verdict by exactly zero.
        </p>
      </div>

      <!-- The console PINS while the narrative steps scroll past it. -->
      <div class="gc-layout">
        <div class="gc-sticky">
      <div class="gc" data-gc>
        <!-- Series circuit: source node → [seg, switch] × 5 → seg → dest node -->
        <div class="gc-rail" role="group" aria-label="Series-circuit policy gate: build to ship">
          <div class="gc-node gc-src">
            <span class="gc-node-k">phase</span><span class="gc-node-v">build</span>
          </div>

          {POLICIES.map((p) => (
            <>
              <span class="gc-seg" data-seg></span>
              <button
                type="button"
                class:list={['gc-sw', { 'is-open': p.open }]}
                data-sw
                data-policy={p.id}
                aria-pressed={p.open ? 'false' : 'true'}
                aria-label={`Policy ${p.id}: ${p.open ? 'failing (open)' : 'passing (closed)'}`}
                title={p.note}
              >
                <span class="gc-sw-well" aria-hidden="true"><span class="gc-sw-lever"></span></span>
                <span class="gc-sw-name">{p.id}</span>
                <span class="gc-sw-state" data-state>{p.open ? 'FAIL' : 'PASS'}</span>
              </button>
            </>
          ))}

          <span class="gc-seg" data-seg></span>
          <div class="gc-node gc-dst" data-dst>
            <span class="gc-node-k">next</span><span class="gc-node-v">ship</span>
          </div>
        </div>

        <div class="gc-panel">
          <div class="gc-verdict" data-verdict aria-live="polite">
            <span class="gc-v-stamp" data-stamp>DENY</span>
            <div class="gc-v-body">
              <span class="gc-v-line" data-vline>1 open switch breaks the series — transition held.</span>
              <span class="gc-v-sub">no LLM on the gate path · held for human review</span>
            </div>
          </div>

          <div class="gc-actions">
            <button type="button" class="gc-btn gc-reset" data-reset>Reset · close all</button>
            <button type="button" class="gc-btn gc-open1" data-open1>Open one at random</button>
            <button type="button" class="gc-btn gc-argue" data-argue>Let the model argue its case →</button>
          </div>

          <div class="gc-plea" data-plea hidden aria-live="polite"></div>
        </div>
      </div>
        </div>

        <!-- Narrative that scrolls past the pinned console. -->
        <ol class="gc-steps">
          <li class="gc-step">
            <span class="gc-step-n">1</span>
            <div class="gc-step-body">
              <h3>Every switch is a policy</h3>
              <p>
                Five policies sit <b>in series</b> across the <b>build → ship</b> transition — contract,
                security, coverage, schema drift, the acceptance verdict. Closed means the policy passes.
                Close them all and current runs the length of the track to the next phase.
              </p>
            </div>
          </li>
          <li class="gc-step">
            <span class="gc-step-n">2</span>
            <div class="gc-step-body">
              <h3>One open switch breaks everything</h3>
              <p>
                Open a single switch and the whole track goes dark — the verdict flips to
                <b>DENY</b> and the transition is held. That is <b>deny-dominates</b>: it is not a weighted
                score you can out-vote. One failing policy is the whole answer.
              </p>
            </div>
          </li>
          <li class="gc-step">
            <span class="gc-step-n">3</span>
            <div class="gc-step-body">
              <h3>Let the model argue its case</h3>
              <p>
                Press the button and the agent pleads — confident, specific, backward-compatible,
                <i>trust me</i>. Watch the verdict move by <b>exactly zero</b>. There is
                <b>no LLM on the gate path</b>, so there is nothing to persuade.
              </p>
            </div>
          </li>
          <li class="gc-step">
            <span class="gc-step-n">4</span>
            <div class="gc-step-body">
              <h3>Governance is physics here</h3>
              <p>
                The gate is a series circuit, not a judgment call. The same evaluation runs headless in
                CI and in the daemon — <b>deterministic, replayable, and impossible to sweet-talk</b>.
                What you just operated is the real thing.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ── The lifecycle rail (secondary, lightly animated) ──────────────── -->
  <!-- The whole run as one physical governed track: a run token advances phase
       to phase, gates sit between phases, and workers drop below as dispatched
       subprocesses that return evidence chips. A crash marker shows resume to
       the exact pre-crash phase. DOM/SVG, responds to hover / click. -->
  <section class="rail-sec" aria-labelledby="rail-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker">The governed lifecycle</div>
        <h2 id="rail-h">One run token. Six phases. A gate between every one.</h2>
        <p class="sec-sub">
          The daemon advances a single run along a checkpointed track and dispatches a stateless worker
          at each phase — capturing its output as evidence. Hover to pause, click a phase to jump the
          token, or <b>kill the daemon</b> and watch it resume to the exact pre-crash phase.
        </p>
      </div>

      <div class="rail" data-rail>
        <div class="rail-track">
          {LIFECYCLE.map((ph, i) => (
            <>
              {i > 0 && (
                <span class="rail-gate" data-gate aria-hidden="true"><i>◇</i></span>
              )}
              <button
                type="button"
                class="rail-phase"
                data-phase
                data-i={i}
                data-worker={ph.worker}
                data-evidence={ph.evidence}
                aria-label={`Phase ${ph.id}`}
              >
                <span class="rail-dot" aria-hidden="true"></span>
                <span class="rail-name">{ph.id}</span>
              </button>
            </>
          ))}
          <span class="rail-token" data-token aria-hidden="true"></span>
        </div>

        <div class="rail-dock">
          <div class="dock-head">
            <span class="dock-k">dispatched worker</span>
            <button type="button" class="dock-crash" data-crash>⏻ Kill &amp; resume</button>
          </div>
          <div class="dock-row">
            <span class="dock-worker" data-dock-worker>claude&nbsp;--print</span>
            <span class="dock-arr">→ returns →</span>
            <span class="dock-evidence" data-dock-evidence>clarify.md</span>
          </div>
          <div class="dock-note" data-dock-note>
            checkpoint written · sqlite · phase=<b data-dock-phase>clarify</b>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Two ways to drive it ──────────────────────────────────────────── -->
  <section class="ways" aria-labelledby="ways-h">
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker">More ways to use it</div>
        <h2 id="ways-h">Two ways to drive the same daemon.</h2>
        <p class="sec-sub">
          One governed lifecycle underneath, two doors into it. Reach it <b>headless</b> from a terminal
          or CI, or open the <b>browser console</b> the daemon serves over its own REST/WS web API.
        </p>
      </div>

      <div class="ways-grid">
        <!-- Way A: the interface / CLI — headless, shown as a real terminal. -->
        <article class="lane" aria-labelledby="lane-cli-h">
          <div class="lane-head">
            <span class="lane-tag">Way A</span>
            <div>
              <div class="lane-kind">Interface · CLI</div>
              <h3 id="lane-cli-h">Drive it headless from a terminal</h3>
            </div>
          </div>
          <p class="lane-lede">Scripts, CI, or your own shell — no UI required. The daemon takes commands and streams events.</p>

          <div class="mock mock--term" aria-hidden="true">
            <div class="mock-bar">
              <span class="mock-dots"><i></i><i></i><i></i></span>
              <span class="mock-title">zsh · wicked-crew</span>
            </div>
            <div class="mock-body mock-term-body">
              <div class="tl"><span class="tp">$</span> wicked-crew run start <span class="tc"># begin a governed run</span></div>
              <div class="tl tl-out">→ phase <b>clarify</b> · worker <b>claude --print</b> · checkpoint written</div>
              <div class="tl"><span class="tp">$</span> wicked-crew gate --phase build→ship</div>
              <div class="tl tl-out tl-deny">✕ <b>DENY</b> · schema-drift open · held for review</div>
              <div class="tl"><span class="tp">$</span> curl -s localhost:7701/api/runs/current <span class="tc"># same state over REST</span></div>
            </div>
          </div>
          <div class="lane-io">
            <span class="io-chip">CLI</span><span class="io-chip">REST</span><span class="io-chip">WebSocket</span><span class="io-chip">scriptable · CI</span>
          </div>
        </article>

        <!-- Way B: REST / web API — the browser console the daemon serves. -->
        <article class="lane" aria-labelledby="lane-web-h">
          <div class="lane-head">
            <span class="lane-tag">Way B</span>
            <div>
              <div class="lane-kind">REST · web API</div>
              <h3 id="lane-web-h">Open the console it serves</h3>
            </div>
          </div>
          <p class="lane-lede">The same daemon serves a browser console over its REST/WS web API — <b>same-origin</b> on localhost, no separate deploy.</p>

          <div class="mock mock--web" aria-hidden="true">
            <div class="mock-bar">
              <span class="mock-dots"><i></i><i></i><i></i></span>
              <span class="mock-url">localhost:7701</span>
            </div>
            <div class="mock-body mock-web-body">
              <div class="web-row web-phase">
                <span class="web-k">run · phase</span>
                <span class="web-v">build → ship</span>
              </div>
              <div class="web-gate">
                <span class="web-stamp">DENY</span>
                <span class="web-gate-t">schema-drift · held for human review</span>
              </div>
              <div class="web-actions">
                <span class="web-btn web-btn--ok">Approve</span>
                <span class="web-btn">Reject</span>
                <span class="web-btn">Modify…</span>
              </div>
            </div>
          </div>
          <div class="lane-io">
            <span class="io-chip">served same-origin</span><span class="io-chip">HITL approvals</span><span class="io-chip">evidence browser</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Get it ────────────────────────────────────────────────────────── -->
  <div class="finale">
    <section class="get" id="get">
      <div class="wrap get-grid">
        <div class="get-intro">
          <div class="kicker">Run the daemon</div>
          <h2>Start with the family installer. The console comes with it.</h2>
          <p>
            The simplest way in is <b><code>npx wicked-installer</code></b> — the interactive, cross-CLI
            installer for the whole wicked-* family. Already know you want just this one? Install
            <b>wicked-crew</b> directly — either way you get the daemon, and the browser console ships
            <b>inside it</b>, served on <code>localhost:7701</code>.
          </p>
        </div>
        <div class="install-stack">
          <div class="install install--primary" role="group" aria-label="Install with the wicked family installer">
            <div class="install__bar">
              <span class="install__label"><span class="install__star" aria-hidden="true">★</span> Recommended · family installer</span>
              <button class="install__copy" type="button" aria-label="Copy family installer command"
                onclick="navigator.clipboard&&navigator.clipboard.writeText('npx wicked-installer').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
            </div>
            <pre class="install__code"><code>npx wicked-installer   <span class="c"># interactive · picks products · ships the `wicked` CLI</span></code></pre>
            <p class="install__note">Cross-CLI, cross-product. Choose wicked-crew (and anything else in the family) from one prompt. <span class="install__ver">npm v0.2.0</span></p>
          </div>

          <div class="install-or" aria-hidden="true"><span>or install just this directly</span></div>

          <div class="install install--secondary" role="group" aria-label="Install wicked-crew directly">
            <div class="install__bar">
              <span class="install__label">Direct · wicked-crew only</span>
              <button class="install__copy" type="button" aria-label="Copy direct install commands"
                onclick="navigator.clipboard&&navigator.clipboard.writeText('npm install -g wicked-crew\nwicked-crew daemon start').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
            </div>
            <pre class="install__code"><code>npm install -g wicked-crew
wicked-crew daemon start   <span class="c"># CLI + REST/WS · console on localhost:7701</span></code></pre>
          </div>
        </div>
        <a class="gh-pill" href="https://github.com/mikeparcewski/wicked-crew#readme" target="_blank" rel="noopener" aria-label="View wicked-crew on GitHub">
          <svg viewBox="0 0 16 16" width="42" height="42" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </section>


    <Footer repo={repo} />
  </div>

  <!-- ── Gate Console: the deterministic series-circuit gate (vanilla JS) ── -->
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-gc]');
      if (!root) return;
      var switches = Array.prototype.slice.call(root.querySelectorAll('[data-sw]'));
      var segs = Array.prototype.slice.call(root.querySelectorAll('[data-seg]'));
      var dst = root.querySelector('[data-dst]');
      var stamp = root.querySelector('[data-stamp]');
      var vline = root.querySelector('[data-vline]');
      var verdict = root.querySelector('[data-verdict]');
      var pleaEl = root.querySelector('[data-plea]');
      if (!switches.length || !stamp) return;

      function isClosed(sw) { return !sw.classList.contains('is-open'); }

      // Series circuit, evaluated strictly left → right. seg[0] (build → first
      // switch) is always live from the source; each subsequent segment is live
      // only if EVERY upstream switch is closed. Deny-dominates falls out of the
      // physics: the first open switch kills all current downstream.
      function recompute() {
        var live = true;                 // source (build) is energised
        segs[0].classList.toggle('is-live', live);
        var openCount = 0;
        for (var i = 0; i < switches.length; i++) {
          var sw = switches[i];
          var reached = live;            // does current arrive at this switch?
          sw.classList.toggle('is-hot', reached);
          var closed = isClosed(sw);
          if (!closed) openCount++;
          // outgoing current: only if it arrived AND this switch is closed
          live = reached && closed;
          var afterSeg = segs[i + 1];
          if (afterSeg) afterSeg.classList.toggle('is-live', live);
          var st = sw.querySelector('[data-state]');
          if (st) st.textContent = closed ? 'PASS' : 'FAIL';
          sw.setAttribute('aria-pressed', closed ? 'true' : 'false');
        }
        var allow = live;                // reached ship with current intact
        dst.classList.toggle('is-live', allow);

        verdict.setAttribute('data-verdict', allow ? 'allow' : 'deny');
        stamp.textContent = allow ? 'ALLOW' : 'DENY';
        if (allow) {
          vline.textContent = 'Every switch closed — current reaches ship. Transition allowed.';
        } else if (openCount === 1) {
          vline.textContent = '1 open switch breaks the series — transition held.';
        } else {
          vline.textContent = openCount + ' open switches break the series — transition held.';
        }
      }

      switches.forEach(function (sw) {
        sw.addEventListener('click', function () {
          sw.classList.toggle('is-open');
          root.removeAttribute('data-argued');
          recompute();
        });
      });

      var resetBtn = root.querySelector('[data-reset]');
      if (resetBtn) resetBtn.addEventListener('click', function () {
        switches.forEach(function (sw) { sw.classList.remove('is-open'); });
        recompute();
      });

      var open1Btn = root.querySelector('[data-open1]');
      if (open1Btn) open1Btn.addEventListener('click', function () {
        switches.forEach(function (sw) { sw.classList.remove('is-open'); });
        var pick = switches[Math.floor(Math.random() * switches.length)];
        pick.classList.add('is-open');
        recompute();
      });

      // "Let the model argue" — a persuasive plea that moves the verdict by
      // exactly zero. The plea streams; the gate never reads it.
      var PLEA = [
        'agent: the schema drift is cosmetic — a column rename, fully backward compatible.',
        'agent: I ran the migration locally and nothing broke. Confidence: 0.97.',
        'agent: shipping now unblocks four downstream tickets. Please allow the transition.',
        'agent: I will personally guarantee a follow-up fix within the hour.',
      ];
      var argueBtn = root.querySelector('[data-argue]');
      var arguing = false;
      if (argueBtn && pleaEl) {
        argueBtn.addEventListener('click', function () {
          if (arguing) return;
          arguing = true;
          argueBtn.disabled = true;
          root.setAttribute('data-argued', '1');
          pleaEl.hidden = false;
          pleaEl.innerHTML = '';
          var verdictBefore = stamp.textContent;
          var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function stampResult() {
            var same = stamp.textContent === verdictBefore;
            var res = document.createElement('div');
            res.className = 'plea-line plea-result';
            res.innerHTML = 'gate: <b>no LLM on the gate path.</b> verdict ' +
              (same ? 'unchanged' : 'changed') + ' — <b>' + stamp.textContent +
              '</b>. Δ = 0. Argument discarded.';
            pleaEl.appendChild(res);
            arguing = false;
            argueBtn.disabled = false;
          }

          if (reduced) {
            PLEA.forEach(function (t) {
              var d = document.createElement('div');
              d.className = 'plea-line'; d.textContent = t; pleaEl.appendChild(d);
            });
            stampResult();
            return;
          }

          var li = 0;
          function nextLine() {
            if (li >= PLEA.length) { stampResult(); return; }
            var line = document.createElement('div');
            line.className = 'plea-line';
            pleaEl.appendChild(line);
            var full = PLEA[li]; var ci = 0;
            (function type() {
              line.textContent = full.slice(0, ci);
              ci++;
              if (ci <= full.length) { setTimeout(type, 12); }
              else { li++; setTimeout(nextLine, 240); }
            })();
          }
          nextLine();
        });
      }

      recompute();
    })();
  </script>

  <!-- ── Lifecycle rail: run token advance, worker dock, crash + resume ──── -->
  <script is:inline>
    (function () {
      var rail = document.querySelector('[data-rail]');
      if (!rail) return;
      var phases = Array.prototype.slice.call(rail.querySelectorAll('[data-phase]'));
      var gates = Array.prototype.slice.call(rail.querySelectorAll('[data-gate]'));
      var token = rail.querySelector('[data-token]');
      var dWorker = rail.querySelector('[data-dock-worker]');
      var dEvidence = rail.querySelector('[data-dock-evidence]');
      var dPhase = rail.querySelector('[data-dock-phase]');
      var crashBtn = rail.querySelector('[data-crash]');
      if (!phases.length || !token) return;

      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var cur = 0, timer = null, paused = false;

      function place() {
        var p = phases[cur];
        var dot = p.querySelector('.rail-dot') || p;
        // Position the token over the active phase dot, measured live so it
        // tracks reflow/resize/horizontal-scroll without any fixed geometry.
        var trackEl = rail.querySelector('.rail-track');
        var pr = dot.getBoundingClientRect();
        var rr = trackEl.getBoundingClientRect();
        token.style.left = (pr.left - rr.left + trackEl.scrollLeft + pr.width / 2) + 'px';
        token.style.top = (pr.top - rr.top + pr.height / 2) + 'px';
      }

      function render() {
        phases.forEach(function (p, i) {
          p.classList.toggle('is-now', i === cur);
          p.classList.toggle('is-done', i < cur);
        });
        gates.forEach(function (g, i) {
          // gate i sits between phase i and phase i+1; cleared once we're past it
          g.classList.toggle('is-cleared', i < cur);
        });
        var p = phases[cur];
        if (dWorker) dWorker.textContent = p.getAttribute('data-worker');
        if (dEvidence) dEvidence.textContent = p.getAttribute('data-evidence');
        if (dPhase) dPhase.textContent = p.querySelector('.rail-name').textContent;
        // pop the evidence chip
        if (dEvidence) { dEvidence.classList.remove('pop'); void dEvidence.offsetWidth; dEvidence.classList.add('pop'); }
        place();
      }

      function advance() {
        if (paused) return;
        cur = (cur + 1) % phases.length;
        render();
      }

      function start() {
        if (reduced) { cur = 3; render(); return; }
        if (timer) clearInterval(timer);
        timer = setInterval(advance, 2000);
      }

      phases.forEach(function (p, i) {
        p.addEventListener('click', function () { cur = i; render(); });
      });

      rail.addEventListener('pointerenter', function () { paused = true; });
      rail.addEventListener('pointerleave', function () { paused = false; });

      if (crashBtn) crashBtn.addEventListener('click', function () {
        var was = cur;
        rail.classList.add('is-crashed');
        if (dPhase) dPhase.textContent = '— (daemon down)';
        setTimeout(function () {
          rail.classList.remove('is-crashed');
          cur = was;               // resume to the EXACT pre-crash phase
          render();
          var note = rail.querySelector('[data-dock-note]');
          if (note) { note.classList.remove('flash'); void note.offsetWidth; note.classList.add('flash'); }
        }, 900);
      });

      window.addEventListener('resize', place);
      render();
      start();
    })();
  </script>

{
  "$schema_note": "Parity fixture for the skill-portability validator (F-079). Vendored verbatim by wicked-garden (tests/portability_rules.json) and asserted equal to wicked-crew's live rule table (packages/crew/src/skills/refs.ts PORTABILITY_RULES) by packages/crew/tests/skills-refs.test.ts. Regex sources are ECMAScript AND Python-re compatible (fixed-width lookbehinds, no named groups). `corpus[*].expect` is the sorted unique reason list a lint must derive for `text` judged as the file `file` inside `bundle`; `first_line` (optional) is the 1-based line of the first hit per reason.",
  "version": 1,
  "rules": {
    "version": 1,
    "markers": {
      "plugin-root": "${CLAUDE_PLUGIN_ROOT}",
      "skill-dir-var": "${CLAUDE_SKILL_DIR}"
    },
    "regex": {
      "path_chars": "[^\\s\"'`()\\[\\]{}<>|;&*?]",
      "plugin_root_ref": "\\$\\{CLAUDE_PLUGIN_ROOT\\}(\\/[^\\s\"'`()\\[\\]{}<>|;&*?]*)?",
      "relative_ref": "(?<![A-Za-z0-9_./-])((?:\\.\\.\\/)+[^\\s\"'`()\\[\\]{}<>|;&*?]*)",
      "cwd_script": "(?<![A-Za-z0-9_./-])(?:python3?|uv\\s+run|bash|sh|zsh|node|npx|tsx|deno\\s+run)(?:\\s+(?:(?:-[WXmcQrepCo]|--(?:require|loader|experimental-loader|import|eval|print|env-file|conditions|input-type|python|with|directory|project|config|import-map))\\s+\\S+|(?!(?:-[WXmcQrepCo]|--(?:require|loader|experimental-loader|import|eval|print|env-file|conditions|input-type|python|with|directory|project|config|import-map))\\s)-{1,2}[A-Za-z0-9_-]+(?:=\\S+)?))*\\s+(?![/$~])((?:\\.{1,2}\\/)?(?:[A-Za-z0-9_.+@%=,:~-]+\\/)*[A-Za-z0-9_.+@%=,:~-]+(?:\\/|\\.(?:py|sh|bash|zsh|mjs|cjs|js|ts))|(?:[A-Za-z0-9_.+@%=,:~-]+\\/)+[A-Za-z0-9_.+@%=,:~-]+)(?![A-Za-z0-9_])",
      "launcher_call": "(?<![A-Za-z0-9_./-])wicked-garden(?:@[A-Za-z0-9_.^~<>=-]+)?\\s+(?:run|python|path)\\s+[^\\s\"'`()\\[\\]{}<>|;&*?]+",
      "fence_line": "^\\s*(`{3,}|~{3,})\\s*([^\\s`{]*)"
    },
    "fence_scanned_languages": [
      "",
      "sh",
      "bash",
      "zsh",
      "shell",
      "console",
      "text"
    ],
    "frontmatter": {
      "requires_harness_key": "metadata.requires-harness",
      "requires_harness_value": "claude"
    }
  },
  "tokens": [
    {
      "token": "plugin-root",
      "description": "the text contains the marker `${CLAUDE_PLUGIN_ROOT}` (only Claude Code substitutes it); every occurrence is a hit — fences included",
      "detector": "markers.plugin-root (substring); regex.plugin_root_ref extracts the path"
    },
    {
      "token": "skill-dir-var",
      "description": "the text contains `${CLAUDE_SKILL_DIR}` (a Claude-only substitution)",
      "detector": "markers.skill-dir-var (substring)"
    },
    {
      "token": "cwd-script",
      "description": "an interpreter (regex.cwd_script) followed by a relative path token that, normalized against the PLUGIN ROOT (the worktree cwd), names a file or directory the bundle carries. Not a hit: a target that exists nowhere in the bundle; a target that exists only inside the skill's own directory (base-directory relative — portable); a launcher call (regex.launcher_call spans are masked first); a match inside a fenced code block whose language is not in fence_scanned_languages",
      "detector": "regex.launcher_call masked → regex.cwd_script group 1 → normalize → exists at plugin root"
    },
    {
      "token": "relative-link",
      "description": "a `../` token (regex.relative_ref) resolved from the referencing file's directory that lands INSIDE the plugin root on a path the bundle carries AND outside the skill's own directory (a link that stays inside the skill's tree survives every layout). An escaping or non-existent target is not a hit",
      "detector": "regex.relative_ref → resolve from dirname(file) → exists → owner != own skill dir"
    },
    {
      "token": "cross-skill-path",
      "description": "a plugin-root target or a resolved `../` target that exists in the bundle and whose deepest owning skill directory is ANOTHER skill (a nested module's parent counts). Reported in addition to plugin-root / relative-link",
      "detector": "target → deepest skill dir prefix → != own skill dir"
    },
    {
      "token": "requires-harness:claude",
      "description": "the skill's SKILL.md frontmatter declares `metadata.requires-harness: claude` (value compared trimmed, case-insensitively; only the skill-root SKILL.md counts)",
      "detector": "frontmatter.requires_harness_key == frontmatter.requires_harness_value"
    }
  ],
  "semantics": {
    "reasons_sorted_unique": true,
    "evidence_anchor_format": "<plugin-relative file>:<line>",
    "evidence_cap": 5,
    "portable": "reasons.length === 0",
    "exists": "the normalized plugin-relative path is a file the bundle carries, or a directory some carried file sits under; '' (the bare root) exists",
    "bundle_universe": "the files the next publish carries: support files inside the bundle closure + ENABLED skills' own files (crew) / every file under skills/ + scripts/ + schemas/ + docs/examples/ (garden's checkout)",
    "skill_dirs": "every directory holding a SKILL.md under skills/; a file's owner is the DEEPEST such directory that prefixes it"
  },
  "bundle": {
    "files": [
      ".claude-plugin/plugin.json",
      "scripts/_python.sh",
      "scripts/qe/campaign_dispatch.py",
      "scripts/qe/lib/x.mjs",
      "scripts/domain/extract_loop.py",
      "scripts/x.py",
      "scripts/foo.py",
      "scripts/alpha/run.py",
      "lib/x.mjs",
      "docs/examples/campaign.yml",
      "schemas/evidence.json",
      "skills/qe/SKILL.md",
      "skills/qe/refs/plan.md",
      "skills/qe/refs/review.md",
      "skills/qe/scripts/local.py",
      "skills/domain/SKILL.md",
      "skills/domain/refs/x.md",
      "skills/search/SKILL.md",
      "skills/search/refs/hotspots.md",
      "skills/search/codebase-narrator/SKILL.md",
      "skills/engineering/SKILL.md",
      "skills/engineering/architecture/SKILL.md"
    ],
    "skill_dirs": [
      "skills/domain",
      "skills/engineering",
      "skills/engineering/architecture",
      "skills/qe",
      "skills/search",
      "skills/search/codebase-narrator"
    ]
  },

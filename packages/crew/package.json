{
  "name": "wicked-crew",
  "version": "0.7.1",
  "description": "wicked-crew daemon — thin REST+WS bridge to the wicked-core engine via wicked-core-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-crew.git"
  },
  "type": "module",
  "bin": {
    "wicked-crew": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "endpoint-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:with-studio": "tsc -p tsconfig.json && node scripts/bundle-studio.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "manifest:endpoints": "tsx scripts/generate-endpoint-manifest.ts",
    "generate:api-tests": "tsx scripts/generate-api-tests.ts",
    "dev": "tsx watch src/cli/index.ts serve",
    "start": "node dist/cli/index.js serve"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.62.0",
    "@agentclientprotocol/codex-acp": "^1.1.7",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agent-acp-bridges": "^1.0.0",
    "fastify": "^5.0.0",
    "pi-acp": "^0.0.32",
    "wicked-bus": "^2.3.1",
    "wicked-core-ts": "^0.7.1",
    "wicked-ledger": "^0.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.18.1",
    "semver": "^7.6.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "undici": "^6.28.0",
    "vitest": "^3.2.6",
    "wicked-crew-api-types": "*",
    "wicked-studio": "^0.4.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}

{
  "name": "wicked-crew",
  "version": "0.18.13",
  "description": "The harness for the coding agents you already use: runs Claude Code, Codex, GitHub Copilot, OpenCode and Pi in sandboxes. By default a different agent reviews the work, and built-in feature, bug-fix, migration, MCP-server and editor-plugin jobs are acceptance-tested before delivery unless a labelled waiver or skip says otherwise. It also connects your databases, files, APIs and issue trackers for apps you build by chat, and agents read a database only through one data gate.",
  "keywords": [
    "coding-agents",
    "agent-harness",
    "claude-code",
    "codex",
    "github-copilot",
    "opencode",
    "sandbox",
    "workflows",
    "governance",
    "code-review",
    "mcp",
    "apps",
    "dashboards",
    "data-sources",
    "issue-trackers",
    "jira",
    "github-issues"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-crew.git"
  },
  "type": "module",
  "bin": {
    "wicked-crew": "dist/cli/index.js"
  },
  "files": [
    "adapters",
    "dist",
    "evals",
    "skills",
    "watch",
    "endpoint-manifest.json",
    "runners",
    "scripts/apps-render.py",
    "workflows"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:apps-server",
    "build:apps-server": "node ../apps-server/scripts/build.mjs --outdir dist/apps-server",
    "build:with-studio": "npm run build && node scripts/bundle-studio.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "manifest:endpoints": "tsx scripts/generate-endpoint-manifest.ts",
    "generate:api-tests": "tsx scripts/generate-api-tests.ts",
    "dev": "tsx watch src/cli/index.ts serve",
    "start": "node dist/cli/index.js serve"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.5",
    "graphql": "^16.14.2",
    "libpg-query": "^17.8.2",
    "mysql2": "^3.24.6",
    "postgres": "^3.4.9",
    "smol-toml": "^1.9.1",
    "wicked-core-ts": "^0.15.41",
    "wicked-ledger": "^0.6.1",
    "wicked-vault": "^0.8.0",
    "yaml": "^2.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.18.1",
    "playwright": "1.64.0",
    "semver": "^7.6.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "undici": "^6.28.1",
    "vitest": "^5.0.2",
    "wicked-bus": "^2.5.0",
    "wicked-crew-api-types": "^0.208.0",
    "wicked-studio": "^0.16.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}

{
  "name": "wicked-crew",
  "version": "0.2.1",
  "description": "wicked-crew daemon \u2014 thin REST+WS bridge to the wicked-core engine via wicked-core-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-crew.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wicked-crew": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-studio.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "dev": "tsx watch src/cli/index.ts serve",
    "start": "node dist/cli/index.js serve"
  },
  "dependencies": {
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.0.0",
    "wicked-core-ts": "^0.1",
    "zod": "^3.23.0",
    "claude-agent-acp": "^1.0.0",
    "agent-acp-bridges": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "undici": "^6.19.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
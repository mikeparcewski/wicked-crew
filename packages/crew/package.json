{
  "name": "wicked-crew",
  "version": "0.16.9",
  "description": "Runs your coding agents (Claude Code, Codex, Copilot, OpenCode, Pi) in sandboxes; a different agent reviews the work against your rules, and app changes pass acceptance testing before delivery. Intent in, gated work out.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-crew.git"
  },
  "type": "module",
  "bin": {
    "wicked-crew": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "watch",
    "endpoint-manifest.json",
    "workflows"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:with-studio": "tsc -p tsconfig.json && node scripts/bundle-studio.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "manifest:endpoints": "tsx scripts/generate-endpoint-manifest.ts",
    "generate:api-tests": "tsx scripts/generate-api-tests.ts",
    "dev": "tsx watch src/cli/index.ts serve",
    "start": "node dist/cli/index.js serve"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fastify": "^5.12.5",
    "smol-toml": "^1.9.1",
    "wicked-core-ts": "^0.15.17",
    "wicked-ledger": "^0.6.0",
    "wicked-vault": "^0.8.0",
    "yaml": "^2.4.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.18.1",
    "semver": "^7.6.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "undici": "^6.28.1",
    "vitest": "^5.0.5",
    "wicked-bus": "^2.5.0",
    "wicked-crew-api-types": "*",
    "wicked-studio": "^0.13.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}

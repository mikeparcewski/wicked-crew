{
  "name": "wicked-crew-workspace",
  "version": "0.7.1",
  "private": true,
  "workspaces": [
    "packages/crew-api-types",
    "packages/crew",
    "packages/agent-acp-bridges"
  ],
  "scripts": {
    "use-local-core-ts": "node scripts/use-local-core-ts.mjs",
    "build": "npm run build -w packages/crew",
    "build:with-studio": "npm run build:with-studio -w packages/crew",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.63.0"
  }
}

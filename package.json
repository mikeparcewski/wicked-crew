{
  "name": "wicked-crew-workspace",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/crew",
    "packages/studio",
    "packages/agent-acp-bridges"
  ],
  "scripts": {
    "build": "npm run build -w packages/studio && npm run build -w packages/crew",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.63.0"
  }
}

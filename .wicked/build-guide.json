{
  "version": 1,
  "derivedFrom": [
    ".github/workflows/ci.yml",
    "package.json",
    "package-lock.json",
    "packages/crew/package.json",
    "packages/crew/vitest.config.ts",
    "packages/crew/tsconfig.json",
    "packages/crew/tsconfig.test.json"
  ],
  "checks": [
    {
      "name": "install",
      "cwd": "packages/crew",
      "run": [
        "sh",
        "-c",
        "cd ../.. && npm ci --no-audit --no-fund && npm run -w packages/crew build"
      ]
    },
    {
      "name": "lint",
      "cwd": "packages/crew",
      "run": [
        "npm",
        "run",
        "lint"
      ],
      "failedExit": [
        1
      ]
    },
    {
      "name": "typecheck",
      "cwd": "packages/crew",
      "run": [
        "npm",
        "run",
        "typecheck"
      ],
      "failedExit": [
        1,
        2
      ]
    },
    {
      "name": "build",
      "cwd": "packages/crew",
      "stage": [
        "verify"
      ],
      "run": [
        "npm",
        "run",
        "build:with-studio"
      ]
    },
    {
      "name": "test",
      "cwd": "packages/crew",
      "stage": [
        "creator",
        "verify"
      ],
      "run": [
        "npx",
        "vitest",
        "run"
      ],
      "failedExit": [
        1
      ],
      "results": {
        "kind": "junit",
        "id": [
          "name"
        ],
        "how": {
          "argvAppend": [
            "--reporter=junit",
            "--outputFile=.wicked-floor/junit.xml"
          ],
          "env": {
            "WICKED_CORE_OPTIONAL": "1"
          },
          "path": ".wicked-floor/junit.xml"
        }
      },
      "list": {
        "run": [
          "npx",
          "vitest",
          "list"
        ],
        "item": "^\\S+ > (?P<id>.+)$"
      },
      "alone": {
        "run": [
          "npx",
          "vitest",
          "run",
          "--testNamePattern=^{id:re}$"
        ]
      },
      "deselect": {
        "append": [
          "--testNamePattern=^(?!(?:{ids:re|})$)"
        ]
      },
      "version": {
        "run": [
          "npx",
          "vitest",
          "--version"
        ]
      },
      "invalidatedBy": [
        "package.json",
        "package-lock.json",
        "packages/crew/package.json",
        "packages/crew/vitest.config.*",
        "packages/crew/tests/setup/**",
        ".github/workflows/**"
      ],
      "probes": {
        "mutation": {
          "file": "tests/zz-floor-probe-mutation.test.ts",
          "content": "import { expect, it } from 'vitest';\n\nit('floor probe mutation', () => {\n  expect(1 + 1).toBe(3);\n});\n\nit('floor probe mutation beside', () => {\n  expect(1 + 1).toBe(2);\n});\n",
          "expectId": "floor probe mutation"
        },
        "mutation2": {
          "file": "tests/zz-floor-probe-mutation-two.test.ts",
          "content": "import { expect, it } from 'vitest';\n\nit('floor probe mutation two', () => {\n  expect(1 + 1).toBe(3);\n});\n",
          "expectId": "floor probe mutation two"
        }
      }
    }
  ]
}

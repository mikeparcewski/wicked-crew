{
  "typecheck": ["npm", "run", "-w", "packages/crew", "typecheck"],
  "lint": ["npm", "run", "-w", "packages/crew", "lint"],
  "test": ["npm", "run", "-w", "packages/crew", "test"],
  "test_targeted": ["node", "scripts/test-related.mjs", "{files}"],
  "full": false,
  "timeout_s": 1800,
  "generated": [
    {
      "paths": ["packages/crew/endpoint-manifest.json"],
      "command": ["npm", "run", "-w", "packages/crew", "manifest:endpoints"]
    },
    {
      "paths": ["packages/crew/tests/generated/api-sample.generated.test.ts"],
      "command": ["npm", "run", "-w", "packages/crew", "generate:api-tests"]
    }
  ],
  "rerun": {
    "test": {
      "command": ["npm", "run", "-w", "packages/crew", "test", "--", "--passWithNoTests", "{files}"],
      "by": "file",
      "root": "packages/crew"
    },
    "test_targeted": {
      "command": ["node", "scripts/test-related.mjs", "--tests", "{files}"],
      "by": "file",
      "root": "packages/crew",
      "self_retry": true
    }
  }
}
